<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gunfight Host Panel - the native control app (klaze, 2026-09-20: "a windows app similar
       to .net or qt", friends run the exe with nothing installed). WPF on .NET 9, published
       self-contained single-file (publish.ps1). No NuGet packages: the build works offline and
       the exe carries only the runtime + this code. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GfPanel</RootNamespace>
    <AssemblyName>GfPanel</AssemblyName>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>2.0.0</Version>
    <Product>Gunfight Host Panel</Product>
    <Company>gunfight.us</Company>
    <!-- single-file publish: extract the native WPF bits beside the exe on first run -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
    <!-- the prop catalog (docs/notes/prop-catalog.md), embedded so the single exe carries it -->
    <EmbeddedResource Include="..\..\..\docs\data\map-props.json" LogicalName="GfPanel.Data.map-props.json" />
  </ItemGroup>

</Project>
