<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ═══ Palette: the rcon tool's dark navy theme (app.css :root), as brushes ═══ -->
  <Color x:Key="C.Bg">#FF0D0F17</Color>
  <Color x:Key="C.Sf">#FF141720</Color>
  <Color x:Key="C.Sf2">#FF1C2030</Color>
  <Color x:Key="C.Bd">#FF252840</Color>
  <Color x:Key="C.Ac">#FF00B4FF</Color>
  <Color x:Key="C.Ok">#FF2EC653</Color>
  <Color x:Key="C.Ng">#FFE63946</Color>
  <Color x:Key="C.Wn">#FFFFD60A</Color>
  <Color x:Key="C.Tx">#FFDCE4FF</Color>
  <Color x:Key="C.Dm">#FF7880A0</Color>

  <SolidColorBrush x:Key="Bg"  Color="{StaticResource C.Bg}" />
  <SolidColorBrush x:Key="Sf"  Color="{StaticResource C.Sf}" />
  <SolidColorBrush x:Key="Sf2" Color="{StaticResource C.Sf2}" />
  <SolidColorBrush x:Key="Bd"  Color="{StaticResource C.Bd}" />
  <SolidColorBrush x:Key="Ac"  Color="{StaticResource C.Ac}" />
  <SolidColorBrush x:Key="Ok"  Color="{StaticResource C.Ok}" />
  <SolidColorBrush x:Key="Ng"  Color="{StaticResource C.Ng}" />
  <SolidColorBrush x:Key="Wn"  Color="{StaticResource C.Wn}" />
  <SolidColorBrush x:Key="Tx"  Color="{StaticResource C.Tx}" />
  <SolidColorBrush x:Key="Dm"  Color="{StaticResource C.Dm}" />
  <SolidColorBrush x:Key="AcDim" Color="#3300B4FF" />
  <SolidColorBrush x:Key="OkDim" Color="#332EC653" />
  <SolidColorBrush x:Key="NgDim" Color="#33E63946" />
  <SolidColorBrush x:Key="WnDim" Color="#33FFD60A" />
  <SolidColorBrush x:Key="TeamA" Color="#FF7AB4FF" />
  <SolidColorBrush x:Key="TeamADim" Color="#245A96FF" />
  <SolidColorBrush x:Key="TeamX" Color="#FFFF8A7A" />
  <SolidColorBrush x:Key="TeamXDim" Color="#24FF5A5A" />
  <SolidColorBrush x:Key="TeamS" Color="#FFA0A0B4" />
  <SolidColorBrush x:Key="TeamSDim" Color="#1F9696AA" />

  <FontFamily x:Key="Font">Segoe UI</FontFamily>
  <FontFamily x:Key="Mono">Consolas</FontFamily>
  <sys:Double x:Key="FontSize">13</sys:Double>
  <CornerRadius x:Key="Radius">6</CornerRadius>

  <!-- ═══ Base text / tooltips ═══ -->
  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="FontFamily" Value="{StaticResource Font}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Dim" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource Dm}" />
  </Style>
  <Style x:Key="Small" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Dm}" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
  </Style>

  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="#FF0A0C14" />
    <Setter Property="Foreground" Value="#FF9AA0C0" />
    <Setter Property="BorderBrush" Value="{StaticResource Bd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MaxWidth" Value="380" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="Foreground" Value="#FF9AA0C0" />
                  <Setter Property="FontSize" Value="11" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ═══ Buttons: default (ghost), Accent, Ok, Ng, Wn; size modifiers via Padding ═══ -->
  <Style TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{StaticResource Sf2}" />
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontFamily" Value="{StaticResource Font}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Ac}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Accent" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Ac}" />
    <Setter Property="Foreground" Value="#FF06101A" />
    <Setter Property="BorderBrush" Value="{StaticResource Ac}" />
  </Style>
  <Style x:Key="OkBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource OkDim}" />
    <Setter Property="Foreground" Value="{StaticResource Ok}" />
    <Setter Property="BorderBrush" Value="#662EC653" />
  </Style>
  <Style x:Key="NgBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource NgDim}" />
    <Setter Property="Foreground" Value="{StaticResource Ng}" />
    <Setter Property="BorderBrush" Value="#66E63946" />
  </Style>
  <Style x:Key="WnBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource WnDim}" />
    <Setter Property="Foreground" Value="{StaticResource Wn}" />
    <Setter Property="BorderBrush" Value="#66FFD60A" />
  </Style>
  <Style x:Key="SmallBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="SmallAccent" TargetType="{x:Type Button}" BasedOn="{StaticResource Accent}">
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="BigBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- a selectable "chip" (difficulty presets, quick commands) -->
  <Style x:Key="Chip" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>
  <!-- the ☆ pin star -->
  <Style x:Key="Star" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Dm}" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Width" Value="18" />
  </Style>

  <!-- ═══ Toggle switch (a CheckBox styled like the rcon .tog) ═══ -->
  <Style x:Key="Toggle" TargetType="{x:Type CheckBox}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Width="34" Height="18">
            <Border x:Name="track" CornerRadius="9" Background="{StaticResource Bd}" />
            <Ellipse x:Name="thumb" Width="12" Height="12" Fill="{StaticResource Dm}" HorizontalAlignment="Left" Margin="3,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{StaticResource Ac}" />
              <Setter TargetName="thumb" Property="Fill" Value="White" />
              <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- a plain check box (perk grids) -->
  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="box" Width="14" Height="14" CornerRadius="3" Background="{StaticResource Bg}" BorderBrush="{StaticResource Bd}" BorderThickness="1" VerticalAlignment="Center">
              <TextBlock x:Name="tick" Text="✓" FontSize="10" Foreground="{StaticResource Ac}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,-1,0,0" />
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="tick" Property="Visibility" Value="Visible" />
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ac}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="box" Width="14" Height="14" CornerRadius="7" Background="{StaticResource Bg}" BorderBrush="{StaticResource Bd}" BorderThickness="1" VerticalAlignment="Center">
              <Ellipse x:Name="dot" Width="6" Height="6" Fill="{StaticResource Ac}" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="dot" Property="Visibility" Value="Visible" />
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ac}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ═══ Inputs ═══ -->
  <Style TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="CaretBrush" Value="{StaticResource Tx}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontFamily" Value="{StaticResource Font}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="SelectionBrush" Value="{StaticResource AcDim}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Ac}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MonoBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
  </Style>

  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Sf2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AcDim}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="ComboToggle" TargetType="{x:Type ToggleButton}">
    <Border x:Name="bd" Background="{StaticResource Bg}" BorderBrush="{StaticResource Bd}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
      <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Dm}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Ac}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="FontFamily" Value="{StaticResource Font}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton x:Name="tog" Template="{StaticResource ComboToggle}" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{StaticResource Sf}" BorderBrush="{StaticResource Bd}" BorderThickness="1" CornerRadius="5"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0">
                <ScrollViewer>
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type Slider}">
    <Setter Property="Foreground" Value="{StaticResource Ac}" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid VerticalAlignment="Center">
            <Border Height="4" CornerRadius="2" Background="{StaticResource Bd}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Height="4" CornerRadius="2" Background="{StaticResource Ac}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Height="4" Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="14" Height="14">
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Ellipse Fill="{StaticResource Ac}" Stroke="#FF0D0F17" StrokeThickness="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ═══ Scrollbars (thin, dark) ═══ -->
  <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="#FF2A2F48" CornerRadius="3" Margin="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ═══ Tab bar (the rcon .tab-bar) ═══ -->
  <Style TargetType="{x:Type TabControl}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Sf}" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True" Margin="8,0,0,0" />
            </Border>
            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{StaticResource Dm}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,2,-1">
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Ac}" />
              <Setter Property="Foreground" Value="{StaticResource Ac}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Tx}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ═══ Block / card: a titled collapsible section (the rcon .block + .btitle) ═══ -->
  <Style x:Key="Block" TargetType="{x:Type Expander}">
    <Setter Property="IsExpanded" Value="True" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <Border Background="{StaticResource Sf}" BorderBrush="{StaticResource Bd}" BorderThickness="1" CornerRadius="7" Padding="12,9,12,10">
            <StackPanel>
              <ToggleButton x:Name="hdr" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" Focusable="False">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" Padding="0,0,0,4">
                      <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="body" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="body" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BlockTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ac}" />
    <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
  </Style>
  <Style x:Key="SubTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Dm}" />
    <Setter Property="Margin" Value="0,8,0,3" />
    <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
  </Style>
  <!-- the sidebar card -->
  <Style x:Key="Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Sf}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bd}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <!-- pills -->
  <Style x:Key="Pill" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="PillText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- status badge -->
  <Style x:Key="Badge" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ═══ Context menus ═══ -->
  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="Background" Value="{StaticResource Sf}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bd}" />
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
            <StackPanel IsItemsHost="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border x:Name="bd" Background="Transparent" Padding="10,5" CornerRadius="4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <!-- the global TextBlock style (Foreground Tx) outranks the inherited colour, so a MenuItem's own
                       Foreground (Give client mod menu, Kill, Forge mode) never showed - re-point it at the item -->
                  <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
              <Path Grid.Column="1" x:Name="arrow" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource Dm}" StrokeThickness="1.5" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
              <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{StaticResource Sf}" BorderBrush="{StaticResource Bd}" BorderThickness="1" CornerRadius="6" Padding="4">
                  <StackPanel IsItemsHost="True" />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Sf2}" />
            </Trigger>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type Separator}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Height="1" Background="{StaticResource Bd}" Margin="4,3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ═══ ListView / GridView (players table) ═══ -->
  <Style TargetType="{x:Type GridViewColumnHeader}">
    <Setter Property="Foreground" Value="{StaticResource Dm}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
          <Border Background="Transparent" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1" Padding="4,3">
            <ContentPresenter HorizontalAlignment="Left" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ListViewItem}">
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListViewItem}">
          <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1" Padding="0,2">
            <GridViewRowPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Sf2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AcDim}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ListView}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
  </Style>
  <Style TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource Tx}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Sf2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AcDim}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type GridSplitter}">
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AcDim}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource Ac}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ═══ page building blocks shared by the redesigned pages (2026-09-24; were local to TOOLS / MATCH) ═══ -->
  <!-- a labelled row of controls -->
  <Style x:Key="RowLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource Dm}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="110" />
  </Style>
  <Style x:Key="Row" TargetType="{x:Type WrapPanel}">
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <!-- one big action: a wide button with a one-line explanation (ActionNote) under it -->
  <Style x:Key="ActionBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource BigBtn}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style x:Key="ActionOk" TargetType="{x:Type Button}" BasedOn="{StaticResource OkBtn}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="ActionNg" TargetType="{x:Type Button}" BasedOn="{StaticResource NgBtn}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="ActionWn" TargetType="{x:Type Button}" BasedOn="{StaticResource WnBtn}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="ActionNote" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Dim}">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="2,3,2,10" />
  </Style>
  <!-- a page's own sub-tabs (MAPS & SPAWNS, FORGE, DIAGNOSTICS): a lighter, smaller strip than the page tabs, so the two
       levels never read as one row. MainWindow.SelectTab finds a sub-tab by its Tag. -->
  <Style x:Key="SubTab" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="10.5" />
  </Style>
  <Style x:Key="SubTabs" TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
    <Setter Property="ItemContainerStyle" Value="{StaticResource SubTab}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1" Margin="14,4,14,0">
              <TabPanel IsItemsHost="True" />
            </Border>
            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
