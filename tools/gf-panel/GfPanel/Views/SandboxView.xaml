<UserControl x:Class="GfPanel.Views.SandboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GfPanel.Views">
  <!-- SANDBOX (the 2026-09-24 redesign; most of the old TOOLS): the fun and chaos, grouped by what it does - radar, the world, movement fun, weapons, disguises, projectiles + map toys, teleport, streaks, vehicles (+ VEHICLE MODE), race (+ RACE SETTINGS). Players, forge and diagnostics have their own pages. -->
  <UserControl.Resources>
    <v:BindingProxy x:Key="Proxy" Data="{Binding}" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
    <v:ColumnsPanel>
      <v:ColumnsPanel.ItemsSource>
        <CompositeCollection>
      <!-- RADAR & MARKERS (bocw-84 2026-09-23): gf_radar through the acked `radar <n>` verb -->
      <Expander Style="{StaticResource Block}" IsExpanded="True">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="RADAR &amp; MARKERS" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="instant, no reload · HOST = only you (spy plane / H.A.R.P.: your team) · EVERYONE = every player" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="HOST" Style="{StaticResource Dim}" FontSize="10" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="EVERYONE" Style="{StaticResource Dim}" FontSize="10" FontWeight="Bold" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Radar.Features}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2" ToolTip="{Binding Tip}" Background="Transparent">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" />
                  <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Host}" VerticalAlignment="Center" />
                  <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding All}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Marker icon" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Radar.IconList}" DisplayMemberPath="Label" SelectedItem="{Binding Radar.SelectedIcon}" Width="220"
                      ToolTip="Which objective icon the enemy markers use. Enemy ping = the Cold War ping system's red 'enemy spotted' marker (resident every match, unmeasured as a server objective); Escort goal = the race-gate icon, MEASURED rendering - switch to it if the markers do not show." />
            <Button Content="All radar OFF" Style="{StaticResource SmallBtn}" Command="{Binding Radar.AllOff}" Margin="8,0,0,0" />
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}" FontSize="10.5" Margin="0,2,0,6">Red debug boxes are not possible from a script: box / line / sphere / print3d are dev-only builtins that crash retail. The enemy markers are the stock stand-in. The glow only shows inside a streak's pilot view (measured: nothing on foot). Spy plane / H.A.R.P.: just the player in free-for-all, the whole team in team modes. The real streaks (Gunship, Chopper Gunner, Cruise Missile: PLAYERS → Loadout → streak, or SANDBOX → STREAKS) show their pilot's markers; a menu-spawned AC-130 / Chopper Gunner (VEHICLES → Other) is untested for that.</TextBlock>
        </StackPanel>
      </Expander>

      <!-- WORLD & VISION: FUN & VISION + the time scale (was under PLAYER STATE) -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="WORLD &amp; VISION" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="vision sets, shakes, sounds, time scale" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Vision set" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.VisionSets}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedVision}" Width="220" />
            <TextBox Text="{Binding Tools.VisionName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="6,0" ToolTip="or type any vision set name (a name the map lacks is a no-op)" />
            <Button Content="Apply" Style="{StaticResource SmallAccent}" Command="{Binding Tools.VisionApply}" Margin="0,0,4,0" />
            <Button Content="default" Style="{StaticResource SmallBtn}" Command="{Binding Tools.VisionDefault}" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Drunk mode" Style="{StaticResource RowLabel}" />
            <Button Content="on" Command="{Binding Tools.DrunkOn}" Margin="0,0,4,0" ToolTip="a mild continuous camera shake on every living player" />
            <Button Content="off" Command="{Binding Tools.DrunkOff}" Margin="0,0,12,0" />
            <Button Content="💥 Earthquake" Style="{StaticResource WnBtn}" Command="{Binding Tools.Quake}" ToolTip="one strong shake at every player" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Play sound" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.SoundList}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedSound}" Width="220" />
            <Button Content="Play to all" Style="{StaticResource SmallAccent}" Command="{Binding Tools.PlaySound}" Margin="6,0,0,0" ToolTip="playsoundtoplayer with a stock alias the MP scripts use" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Timescale" Style="{StaticResource RowLabel}" />
            <Slider Minimum="10" Maximum="300" Value="{Binding Tools.Timescale}" Width="160" VerticalAlignment="Center" />
            <TextBox Text="{Binding Tools.Timescale, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="6,0" />
            <Button Content="Set" Style="{StaticResource SmallAccent}" Command="{Binding Tools.SlowmoApply}" Margin="0,0,4,0" ToolTip="setslowmotion( 1, pct/100, 0.5 ) - the engine's slow-motion ramp (the final-killcam shape). Untested as a standing timescale." />
            <Button Content="↺ 100%" Style="{StaticResource SmallBtn}" Command="{Binding Tools.SlowmoReset}" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- MOVEMENT FUN: the fun pack's slide + fly-bind switches (the `fun` verb) -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="MOVEMENT FUN" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="the fun pack: slides + fly bind (match-wide unless marked me) · never run" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Fly bind (Tac + Melee)" Style="{StaticResource RowLabel}" />
            <Button Content="On" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="flybind on" Margin="0,2,4,2" ToolTip="fun flybind on - Tactical + Melee toggles fly with the menu closed (the host; a player: PLAYERS → Fun)" />
            <Button Content="Off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="flybind off" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Slide speed" Style="{StaticResource RowLabel}" />
            <Button Content="Stock" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slide 100" Margin="0,2,4,2" ToolTip="fun slide 100 - everyone, per match: the horizontal speed at the slide's start" />
            <Button Content="150%" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slide 150" Margin="0,2,4,2" />
            <Button Content="200%" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slide 200" Margin="0,2,4,2" />
            <Button Content="300%" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slide 300" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Super slide" Style="{StaticResource RowLabel}" />
            <Button Content="Off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidesuper 0" Margin="0,2,4,2" />
            <Button Content="600" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidesuper 600" Margin="0,2,4,2" ToolTip="fun slidesuper 600 - from a slide, glide at 600 u/s along the view until JUMP (6 s cap), humans" />
            <Button Content="1000" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidesuper 1000" Margin="0,2,4,2" />
            <Button Content="1600" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidesuper 1600" Margin="0,2,4,2" />
            <TextBlock Text="Long slide" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <Button Content="On" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidehold on" Margin="0,2,4,2" ToolTip="fun slidehold - keep the start speed for the whole slide" />
            <Button Content="Off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidehold off" Margin="0,2,4,2" />
            <TextBlock Text="No chain penalty (default on)" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <Button Content="On" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidechain on" Margin="0,2,4,2" ToolTip="fun slidechain - slide_subsequentslidescale 0 (off restores the stock 0.1). ON by default since 2026-09-24: the mod sets it at every match start; Off lasts the match. A joiner's prediction may still apply the penalty - unmeasured." />
            <Button Content="Off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidechain off" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="My slide preset" Style="{StaticResource RowLabel}" />
            <Button Content="Super Slide" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidemode 1" Margin="0,2,4,2" ToolTip="fun slidemode 1 - the HOST's own preset: 150% slide speed + long slide (a player: right-click → Fun pack → Slide preset; clients have it on their Player page)" />
            <Button Content="Infinite Slide" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidemode 2" Margin="0,2,4,2" ToolTip="fun slidemode 2 - super slide 700: from a slide, glide the way you look until JUMP (the 6 s cap still applies)" />
            <Button Content="Off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="slidemode 0" Margin="0,2,4,2" ToolTip="back to the match-wide slide settings above" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- WEAPONS + COSMETICS -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header><TextBlock Text="WEAPONS &amp; COSMETICS" Style="{StaticResource BlockTitle}" /></Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Weapon" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.WeaponList}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedWeapon}" Width="260" />
            <Button Content="Give me" Style="{StaticResource SmallAccent}" Command="{Binding Tools.GiveHost}" Margin="6,0,4,0" />
            <Button Content="Give EVERYONE" Style="{StaticResource SmallBtn}" Command="{Binding Tools.GiveAll}" ToolTip="everyone alive gets it and switches to it (this life)" />
          </WrapPanel>
          <TextBlock Text="a player: PLAYERS → Loadout (or right-click them)" Style="{StaticResource Dim}" FontSize="10.5" Margin="110,0,0,4" />
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Camo id" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.CamoNames}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedCamo}" Width="170" ToolTip="named ones; any id 0-149 in the box" />
            <TextBox Text="{Binding Tools.CamoId, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="6,0" />
            <Button Content="Set (host)" Style="{StaticResource SmallAccent}" Command="{Binding Tools.CamoHost}" ToolTip="camo on the host's current weapon; a player: right-click → Cosmetics → Camo" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Operator id" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.OperatorNames}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedOperator}" Width="170" ToolTip="setspecialistindex id (the invisible operator, id 0, is removed - klaze 2026-09-23)" />
            <TextBox Text="{Binding Tools.OperatorId, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="6,0" />
            <Button Content="Set (host)" Style="{StaticResource SmallAccent}" Command="{Binding Tools.OperatorHost}" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Outfit id" Style="{StaticResource RowLabel}" />
            <TextBox Text="{Binding Tools.OutfitId, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="0,0,6,0" ToolTip="0-23 per operator" />
            <Button Content="Set (host)" Style="{StaticResource SmallAccent}" Command="{Binding Tools.OutfitHost}" />
          </WrapPanel>
          <TextBlock Text="Camo fun (the host; a player: PLAYERS → Fun)" Style="{StaticResource SubTitle}" />
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Disco camo" Style="{StaticResource RowLabel}" />
            <Button Content="Me on" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disco on" Margin="0,2,4,2" ToolTip="fun disco on - a random camo on the held gun every 0.2 s" />
            <Button Content="Me off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disco off" Margin="0,2,4,2" />
            <Button Content="Everyone on" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disco all on" Margin="0,2,4,2" />
            <Button Content="Everyone off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disco all off" Margin="0,2,4,2" />
            <Button Content="All OFF" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disco none" Margin="0,2,4,2" />
            <Button Content="Random camo (once)" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="camorandom" Margin="12,2,4,2" ToolTip="fun camorandom - a random camo (1-121) on the gun in hand, once (the client menu's Camo → Random)" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- DISGUISES: the fun pack's Prop-Hunt disguise (the `fun disg` verb) -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="DISGUISES" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="walk around as a prop - the host; a player: PLAYERS → Fun · never run" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Disguise" Style="{StaticResource RowLabel}" />
            <Button Content="Random prop" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disg random" Margin="0,2,4,2" ToolTip="fun disg random - walk around as a prop (Prop Hunt's recipe): ghost()ed, third person, the prop linked to you" />
            <Button Content="Next" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disg next" Margin="0,2,4,2" />
            <Button Content="Previous" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disg prev" Margin="0,2,4,2" />
            <ComboBox ItemsSource="{Binding Fun.DisguiseList}" DisplayMemberPath="Label" SelectedItem="{Binding Fun.SelectedDisguise}" Width="150" Margin="6,0,4,0" />
            <Button Content="Be it" Style="{StaticResource SmallAccent}" Command="{Binding Fun.DisguisePick}" Margin="0,2,4,2" />
            <Button Content="OFF" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disg off" Margin="6,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Disguise size / height" Style="{StaticResource RowLabel}" />
            <Button Content="0.5x" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disgsize 0.5" Margin="0,2,4,2" />
            <Button Content="1x" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disgsize 1" Margin="0,2,4,2" />
            <Button Content="2x" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disgsize 2" Margin="0,2,4,2" />
            <Button Content="4x" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disgsize 4" Margin="0,2,4,2" />
            <Button Content="At the feet" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disgheight 0" Margin="12,2,4,2" />
            <Button Content="Raised 20" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disgheight 20" Margin="0,2,4,2" />
            <Button Content="Raised 40" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="disgheight 40" Margin="0,2,4,2" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- MAP TOYS -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="PROJECTILES &amp; MAP TOYS" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="destructibles · exploders · projectiles · shots, grenade swap, model cannon" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Destructibles" Style="{StaticResource RowLabel}" />
            <Button Content="break aimed" Style="{StaticResource Chip}" Command="{Binding Tools.DestructAim}" Margin="0,2,4,2" />
            <Button Content="break near me (600u)" Style="{StaticResource Chip}" Command="{Binding Tools.DestructNear}" Margin="0,2,4,2" />
            <Button Content="break ALL" Style="{StaticResource Chip}" Command="{Binding Tools.DestructAll}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Exploders" Style="{StaticResource RowLabel}" />
            <Button Content="fire next" Style="{StaticResource Chip}" Command="{Binding Tools.ExpNext}" Margin="0,2,4,2" />
            <Button Content="previous" Style="{StaticResource Chip}" Command="{Binding Tools.ExpPrev}" Margin="0,2,4,2" />
            <Button Content="again" Style="{StaticResource Chip}" Command="{Binding Tools.ExpAgain}" Margin="0,2,4,2" />
            <Button Content="stop current" Style="{StaticResource Chip}" Command="{Binding Tools.ExpStop}" Margin="0,2,4,2" />
            <Button Content="fire ALL (0.5 s apart)" Style="{StaticResource Chip}" Command="{Binding Tools.ExpAll}" Margin="0,2,4,2" />
            <Button Content="stop walk" Style="{StaticResource Chip}" Command="{Binding Tools.ExpStopAll}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Projectiles" Style="{StaticResource RowLabel}" />
            <Button Content="host" Style="{StaticResource Chip}" Command="{Binding Tools.ProjHost}" Margin="0,2,4,2" ToolTip="every shot also fires the chosen projectile down the aim line" />
            <Button Content="everyone" Style="{StaticResource Chip}" Command="{Binding Tools.ProjAll}" Margin="0,2,4,2" />
            <Button Content="OFF" Style="{StaticResource Chip}" Command="{Binding Tools.ProjOff}" Margin="0,2,12,2" />
            <Button Content="homing" Style="{StaticResource Chip}" Command="{Binding Tools.ProjHoming}" Margin="0,2,4,2" ToolTip="lock the enemy the shooter faces" />
            <Button Content="trail FX" Style="{StaticResource Chip}" Command="{Binding Tools.ProjTrail}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.ProjectileList}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedProjectile}" Width="230" />
            <Button Content="Set projectile" Style="{StaticResource SmallAccent}" Command="{Binding Tools.ProjWeapon}" Margin="6,0,12,0" />
            <TextBlock Text="rate ms" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Tools.ProjRates}" SelectedItem="{Binding Tools.ProjRate}" Width="70" />
            <Button Content="Set" Style="{StaticResource SmallBtn}" Command="{Binding Tools.ProjRateSet}" Margin="4,0,12,0" />
            <TextBlock Text="method" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="projmethod 0-6 - 0 = AUTO (the GSC picks per weapon), 1-6 the spawn-method variants under test" />
            <ComboBox ItemsSource="{Binding Tools.ProjMethods}" SelectedItem="{Binding Tools.ProjMethod}" Width="50" />
            <Button Content="Set" Style="{StaticResource SmallBtn}" Command="{Binding Tools.ProjMethodSet}" Margin="4,0,0,0" />
          </WrapPanel>
          <TextBlock Text="props + explosive barrels: FORGE → PROPS · the PROJ debug line: DIAGNOSTICS" Style="{StaticResource Dim}" FontSize="10.5" Margin="110,2,0,0" />
          <TextBlock Text="PROJECTILE EXTRAS" Style="{StaticResource SubTitle}" />
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Shots per trigger" Style="{StaticResource RowLabel}" />
            <Button Content="1" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="projcount 1" Margin="0,2,4,2" ToolTip="fun projcount - extra projectile spawns per trigger pull, spread 6 degrees (the projectile feature must be on)" />
            <Button Content="3" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="projcount 3" Margin="0,2,4,2" />
            <Button Content="5" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="projcount 5" Margin="0,2,4,2" />
            <Button Content="8" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="projcount 8" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Grenade swap" Style="{StaticResource RowLabel}" />
            <Button Content="Me on" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="nadeswap on" Margin="0,2,4,2" ToolTip="fun nadeswap - a thrown grenade is replaced by the picked type, thrown along the view (a player with the teleport grenade armed keeps theirs)" />
            <Button Content="Me off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="nadeswap off" Margin="0,2,4,2" />
            <Button Content="Everyone on" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="nadeswap all on" Margin="0,2,4,2" />
            <Button Content="Everyone off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="nadeswap all off" Margin="0,2,4,2" />
            <Button Content="All OFF" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="nadeswap none" Margin="0,2,4,2" />
            <ComboBox ItemsSource="{Binding Fun.NadeTypeList}" DisplayMemberPath="Label" SelectedItem="{Binding Fun.SelectedNade}" Width="210" Margin="6,0,0,0" ToolTip="the swap-to type - sent when picked" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Model cannon" Style="{StaticResource RowLabel}" />
            <Button Content="Me on" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="cannon on" Margin="0,2,4,2" ToolTip="fun cannon - every shot launches a prop to where the shot lands" />
            <Button Content="Me off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="cannon off" Margin="0,2,4,2" />
            <Button Content="Blast on" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="cannonblast on" Margin="8,2,4,2" />
            <Button Content="Blast off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="cannonblast off" Margin="0,2,4,2" />
            <Button Content="Ride a rocket on" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="cannonride on" Margin="8,2,4,2" ToolTip="the prop rides a real RPG rocket (its flight and hit)" />
            <Button Content="Ride off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="cannonride off" Margin="0,2,4,2" />
            <Button Content="Keep props on" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="cannonkeep on" Margin="8,2,4,2" ToolTip="landed props stay (not saved, 64 max, listed in ENTITIES, cleared with the props)" />
            <Button Content="Keep off" Style="{StaticResource Chip}" Command="{Binding Fun.Send}" CommandParameter="cannonkeep off" Margin="0,2,4,2" />
            <ComboBox ItemsSource="{Binding Fun.CannonModelList}" DisplayMemberPath="Label" SelectedItem="{Binding Fun.SelectedCannon}" Width="150" Margin="6,0,0,0" ToolTip="what the cannon fires - sent when picked" />
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}" FontSize="10.5" Margin="0,2,0,6">The fun pack's 8 new projectile types and spawn method 7 (magicmissile) are in the projectile pickers; its 9 new vehicles are at the end of the vehicle list. ESP was left out: RADAR &amp; MARKERS already does the minimap, the markers and the glow.</TextBlock>
        </StackPanel>
      </Expander>

      <!-- TELEPORT -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="TELEPORT" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="crosshair = where the host aims · saved point survives rounds · everyone never includes bots" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Everyone" Style="{StaticResource RowLabel}" />
            <Button Content="to me" Style="{StaticResource Chip}" Command="{Binding Tools.TpAllMe}" Margin="0,2,4,2" ToolTip="ring around the host + 1.5 s invulnerability (the double-elimination fix)" />
            <Button Content="to crosshair" Style="{StaticResource Chip}" Command="{Binding Tools.TpAllAim}" Margin="0,2,4,2" />
            <Button Content="to saved point" Style="{StaticResource Chip}" Command="{Binding Tools.TpAllSaved}" Margin="0,2,4,2" />
            <Button Content="to map centre" Style="{StaticResource Chip}" Command="{Binding Tools.TpAllCentre}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="My team" Style="{StaticResource RowLabel}" />
            <Button Content="to me" Style="{StaticResource Chip}" Command="{Binding Tools.TpTeamMe}" Margin="0,2,4,2" />
            <Button Content="to crosshair" Style="{StaticResource Chip}" Command="{Binding Tools.TpTeamAim}" Margin="0,2,12,2" />
            <TextBlock Text="Other team" Style="{StaticResource RowLabel}" MinWidth="0" Margin="0,0,6,0" />
            <Button Content="to me" Style="{StaticResource Chip}" Command="{Binding Tools.TpEnemyMe}" Margin="0,2,4,2" />
            <Button Content="to crosshair" Style="{StaticResource Chip}" Command="{Binding Tools.TpEnemyAim}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Me" Style="{StaticResource RowLabel}" />
            <Button Content="to crosshair" Style="{StaticResource Chip}" Command="{Binding Tools.TpMeAim}" Margin="0,2,4,2" />
            <Button Content="to saved point" Style="{StaticResource Chip}" Command="{Binding Tools.TpMeSaved}" Margin="0,2,4,2" />
            <Button Content="to map centre" Style="{StaticResource Chip}" Command="{Binding Tools.TpMeCentre}" Margin="0,2,12,2" />
            <Button Content="Save point = here" Style="{StaticResource SmallAccent}" Command="{Binding Tools.TpSave}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Toggles" Style="{StaticResource RowLabel}" />
            <Button Content="TP gun: host" Style="{StaticResource Chip}" Command="{Binding Tools.TpGunHost}" Margin="0,2,4,2" ToolTip="shots teleport the shooter to the impact point (the menu's next-item key is ATTACK, so the gun ignores shots while the in-game menu is open)" />
            <Button Content="TP gun: everyone" Style="{StaticResource Chip}" Command="{Binding Tools.TpGunAll}" Margin="0,2,4,2" />
            <Button Content="TP grenade: host" Style="{StaticResource Chip}" Command="{Binding Tools.TpNadeHost}" Margin="0,2,4,2" ToolTip="a thrown grenade teleports the thrower where it lands (the Gersh device)" />
            <Button Content="TP grenade: everyone" Style="{StaticResource Chip}" Command="{Binding Tools.TpNadeAll}" Margin="0,2,4,2" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- STREAKS (bocw-1c 2026-09-21) -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="STREAKS" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="killstreaks::give - the care-package path; used with the normal streak button · NEVER RUN" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Give to" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.StreakTargets}" DisplayMemberPath="Name" SelectedItem="{Binding Tools.StreakTarget}" Width="200" Margin="0,0,6,0" ToolTip="a human in the match; empty = you (the host)" />
            <Button Content="RC-XD" Style="{StaticResource SmallAccent}" Command="{Binding Tools.StreakRcxd}" Margin="0,0,4,0" ToolTip="streak recon_car" />
            <Button Content="Bow (Sparrow)" Style="{StaticResource SmallAccent}" Command="{Binding Tools.StreakBow}" Margin="0,0,4,0" ToolTip="streak sig_bow_flame" />
            <Button Content="Nuke" Style="{StaticResource NgBtn}" Command="{Binding Tools.StreakNuke}" ToolTip="streak nuke" />
            <TextBlock Text="a player: PLAYERS → Loadout" Style="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Any streak" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.StreakList}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedStreak}" Width="220" Margin="0,0,6,0" ToolTip="the full stock set (streak_master): UAV, H.A.R.P., care package, armor, turrets, napalm, artillery, cruise missile, air patrol, strafe run, attack heli, VTOL, chopper gunner, gunship, war machine, hand cannon, death machine, flamethrower, ray gun…" />
            <Button Content="Give" Style="{StaticResource SmallAccent}" Command="{Binding Tools.StreakGive}" ToolTip="streak &lt;kstype&gt; to the picked player (or you)" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- VEHICLES -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="VEHICLES" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="{Binding Tools.VehicleNote}" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Drivable" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.DrivableVehicles}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedVehicle}" Width="260" />
            <Button Content="Spawn ahead of me" Style="{StaticResource SmallAccent}" Command="{Binding Tools.VehSpawn}" Margin="6,0,0,0" ToolTip="vehspawn &lt;index&gt; - isassetloaded-gated; aircraft above the host; a non-resident class just says so" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Other" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.OtherVehicles}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedOtherVehicle}" Width="260" />
            <Button Content="Spawn (untested)" Style="{StaticResource SmallBtn}" Command="{Binding Tools.VehSpawnOther}" Margin="6,0,0,0" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="" Style="{StaticResource RowLabel}" />
            <Button Content="Enter the vehicle I aim at" Style="{StaticResource Chip}" Command="{Binding Tools.VehEnter}" Margin="0,2,4,2" />
            <Button Content="Livery ◀" Style="{StaticResource Chip}" Command="{Binding Tools.VehLiveryPrev}" Margin="0,2,4,2" ToolTip="vehlivery prev - the previous model variant of the same body (T-72 Dead Ops colours, sedan police / KGB, van colours, FAV black, Hind, truck canvas / flatbed): the vehicle you sit in, else the one aimed at / nearest within 300 u. Feed ack names the variant; 'none on this map' if the body has no variants resident." />
            <Button Content="Livery ▶" Style="{StaticResource Chip}" Command="{Binding Tools.VehLiveryNext}" Margin="0,2,10,2" ToolTip="vehlivery next" />
            <Button Content="Delete all vehicles" Style="{StaticResource NgBtn}" Command="{Binding Tools.VehClear}" Margin="0,2,4,2" ToolTip="vehclear all - deletes every vehicle the menu / app spawned that is EMPTY; an occupied one is never deleted (get out first). Do this before any map switch." />
          </WrapPanel>
          <TextBlock Text="spawn-riding modes: VEHICLE MODE (on this page)" Style="{StaticResource Dim}" FontSize="10.5" Margin="110,2,0,0" />
        </StackPanel>
      </Expander>

      <!-- RACE -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="RACE" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="a Free-for-all match; gates go where the host stands, across his travel; settings: RACE SETTINGS on this page" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Track" Style="{StaticResource RowLabel}" />
            <Button Content="gate here" Style="{StaticResource Chip}" Command="{Binding Tools.RaceGate}" Margin="0,2,4,2" ToolTip="the first gate is start/finish" />
            <Button Content="undo last gate" Style="{StaticResource Chip}" Command="{Binding Tools.RaceUndo}" Margin="0,2,4,2" />
            <Button Content="clear track" Style="{StaticResource Chip}" Command="{Binding Tools.RaceClear}" Margin="0,2,4,2" />
            <Button Content="load the game's saved track" Style="{StaticResource Chip}" Command="{Binding Tools.RaceLoad}" Margin="0,2,4,2" />
            <Button Content="markers show/hide" Style="{StaticResource Chip}" Command="{Binding Tools.RaceMarkers}" Margin="0,2,4,2" />
            <Button Content="reset me" Style="{StaticResource Chip}" Command="{Binding Tools.RaceResetMe}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Race" Style="{StaticResource RowLabel}" />
            <Button Content="START RACE (3-2-1-GO)" Style="{StaticResource OkBtn}" Command="{Binding Tools.RaceStart}" Margin="0,2,4,2" />
            <Button Content="Stop / cancel" Style="{StaticResource WnBtn}" Command="{Binding Tools.RaceStop}" Margin="0,2,4,2" />
            <Button Content="END MATCH (podium)" Style="{StaticResource NgBtn}" Command="{Binding Tools.RaceEndMatch}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Saved tracks" Style="{StaticResource RowLabel}" />
            <TextBox Text="{Binding Tools.TrackName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,4,0" />
            <Button Content="Save track from game" Style="{StaticResource SmallAccent}" Command="{Binding Tools.TrackSave}" Margin="0,0,12,0" ToolTip="reads the gates the game publishes (GFCFG trk=) into tracks.json" />
            <ComboBox ItemsSource="{Binding Tools.SavedTracks}" SelectedItem="{Binding Tools.SelectedTrack}" Width="230" />
            <Button Content="Load into game" Style="{StaticResource SmallBtn}" Command="{Binding Tools.TrackLoad}" Margin="4,0,4,0" ToolTip="racetrack &lt;map&gt; then one racegate per gate, 0.5 s apart" />
            <Button Content="Delete" Style="{StaticResource SmallBtn}" Command="{Binding Tools.TrackDelete}" />
          </WrapPanel>
        </StackPanel>
      </Expander>

          <CollectionContainer Collection="{Binding Data.SandboxSections, Source={StaticResource Proxy}}" />
        </CompositeCollection>
      </v:ColumnsPanel.ItemsSource>
    </v:ColumnsPanel>
  </ScrollViewer>
</UserControl>
