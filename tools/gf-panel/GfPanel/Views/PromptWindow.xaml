<Window x:Class="GfPanel.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gunfight Host Panel" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Sf}" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow">
  <StackPanel Margin="16">
    <TextBlock x:Name="Label" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBox x:Name="Box" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
      <Button Content="OK" Style="{StaticResource Accent}" Click="Ok_Click" IsDefault="True" MinWidth="70" />
    </StackPanel>
  </StackPanel>
</Window>
