<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GfPanel.ViewModels"
                    xmlns:svc="clr-namespace:GfPanel.Services"
                    xmlns:v="clr-namespace:GfPanel.Views">

  <v:BoolToVis x:Key="Vis" />
  <v:BoolToVis x:Key="VisInv" Invert="True" />
  <v:NullToVis x:Key="NullVis" />
  <v:NullToVis x:Key="NullVisInv" Invert="True" />
  <v:KeyToBrush x:Key="KeyBrush" />
  <v:TeamToBg x:Key="TeamBg" />
  <v:EffToBrush x:Key="EffBrush" />
  <v:HexToBrush x:Key="HexBrush" />
  <v:IntToString x:Key="IntStr" />
  <v:IntEquals x:Key="IntEq" />
  <v:NotConverter x:Key="Not" />
  <v:CountToVis x:Key="CountVis" />

  <!-- ═══ one settings row ═══ -->
  <DataTemplate DataType="{x:Type vm:SettingRowVM}">
    <StackPanel>
      <TextBlock Text="{Binding Group}" Style="{StaticResource SubTitle}" Visibility="{Binding HasGroup, Converter={StaticResource Vis}}" />
      <Grid Margin="0,1" MinHeight="30" ToolTip="{Binding Tip}" Background="Transparent">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding Dvar}" IsEnabled="False" />
            <MenuItem Header="Copy dvar name" Command="{Binding CopyCommand}" />
            <MenuItem Header="Pin / unpin (FAVORITES)" Command="{Binding PinCommand}" />
            <Separator />
            <MenuItem Header="Reset to default" Command="{Binding ResetCommand}" />
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource Star}" Content="{Binding StarGlyph}" Command="{Binding PinCommand}" ToolTip="Pin this setting to FAVORITES" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          <Border Style="{StaticResource Pill}" BorderBrush="{Binding EffLabel, Converter={StaticResource EffBrush}}" ToolTip="{Binding EffTip}">
            <TextBlock Style="{StaticResource PillText}" Text="{Binding EffLabel}" Foreground="{Binding EffLabel, Converter={StaticResource EffBrush}}" />
          </Border>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource Bd}" Visibility="{Binding ShowUnread, Converter={StaticResource Vis}}" ToolTip="No readback from the game has confirmed this value yet - the control shows the default / the last value sent.">
            <TextBlock Style="{StaticResource PillText}" Text="UNREAD" Foreground="{StaticResource Dm}" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
          <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsOn}" Visibility="{Binding IsToggle, Converter={StaticResource Vis}}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedChoice}" MinWidth="190" MaxWidth="290"
                    Visibility="{Binding IsChoice, Converter={StaticResource Vis}}" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsInt, Converter={StaticResource Vis}}">
            <Button Content="−" Style="{StaticResource SmallBtn}" Command="{Binding StepDown}" Width="24" Padding="0,2" />
            <TextBox Text="{Binding Value, Converter={StaticResource IntStr}, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="3,0" TextAlignment="Right" />
            <Button Content="+" Style="{StaticResource SmallBtn}" Command="{Binding StepUp}" Width="24" Padding="0,2" />
            <Button Content="Set" Style="{StaticResource SmallAccent}" Command="{Binding SetCommand}" Margin="4,0,0,0" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="3" Content="↺" Style="{StaticResource SmallBtn}" Command="{Binding ResetCommand}" ToolTip="Reset to the default and apply" Width="26" Padding="0,2" />
      </Grid>
    </StackPanel>
  </DataTemplate>

  <!-- ═══ a section block ═══ -->
  <DataTemplate DataType="{x:Type vm:SectionVM}">
    <Expander Style="{StaticResource Block}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
      <Expander.Header>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource Star}" Content="{Binding StarGlyph}" Command="{Binding PinCommand}" ToolTip="Pin this whole panel to FAVORITES" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource BlockTitle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
          </StackPanel>
          <Button Grid.Column="2" Content="defaults" Style="{StaticResource SmallBtn}" Command="{Binding ResetAllCommand}" ToolTip="Reset every row in this section to its default" FontSize="10" Padding="6,1" />
        </Grid>
      </Expander.Header>
      <ItemsControl ItemsSource="{Binding Rows}" />
    </Expander>
  </DataTemplate>

  <!-- ═══ a favorites group ═══ -->
  <DataTemplate DataType="{x:Type vm:FavGroupVM}">
    <Expander Style="{StaticResource Block}">
      <Expander.Header>
        <TextBlock Text="{Binding Title}" Style="{StaticResource BlockTitle}" />
      </Expander.Header>
      <ItemsControl ItemsSource="{Binding Items}" />
    </Expander>
  </DataTemplate>

  <!-- ═══ a player row (sidebar) ═══ -->
  <DataTemplate DataType="{x:Type vm:PlayerRowVM}">
    <Border Padding="4,3" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1" Background="Transparent" ToolTip="{Binding Xuid}">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{Binding Name}" IsEnabled="False" />
          <MenuItem Header="✉ Message this player…" Command="{Binding Message}" />
          <Separator />
          <MenuItem Header="Move to allies" Command="{Binding MoveAllies}" />
          <MenuItem Header="Move to axis" Command="{Binding MoveAxis}" />
          <MenuItem Header="Move to spectator" Command="{Binding Spectate}" />
          <MenuItem Header="Next match">
            <MenuItem Header="Stage: Allies" Command="{Binding StageA}" />
            <MenuItem Header="Stage: Axis" Command="{Binding StageX}" />
            <MenuItem Header="Stage: Spectator" Command="{Binding StageS}" />
            <MenuItem Header="Unstage" Command="{Binding StageClear}" />
          </MenuItem>
          <Separator />
          <MenuItem Header="God mode" Command="{Binding GodMode}" />
          <MenuItem Header="Max ammo" Command="{Binding MaxAmmo}" />
          <MenuItem Header="Third person" Command="{Binding ThirdPersonCmd}" />
          <MenuItem Header="Fly" Command="{Binding FlyCmd}" />
          <MenuItem Header="Freeze / unfreeze" Command="{Binding Freeze}" />
          <MenuItem Header="Speed">
            <MenuItem Header="50%" Command="{Binding Speed50}" />
            <MenuItem Header="150%" Command="{Binding Speed150}" />
            <MenuItem Header="200%" Command="{Binding Speed200}" />
            <MenuItem Header="Back to global" Command="{Binding Speed0}" />
          </MenuItem>
          <MenuItem Header="Give the picked weapon (Tools)" Command="{Binding GiveWeapon}" />
          <MenuItem Header="Give the picked perk (Tools)" Command="{Binding GivePerks}" />
          <MenuItem Header="Cosmetics (ids from Tools)">
            <MenuItem Header="Camo" Command="{Binding Camo}" />
            <MenuItem Header="Operator" Command="{Binding Operator}" />
            <MenuItem Header="Outfit" Command="{Binding Outfit}" />
          </MenuItem>
          <MenuItem Header="Take current weapon" Command="{Binding TakeWeapon}" />
          <MenuItem Header="Strip all weapons" Command="{Binding Strip}" />
          <MenuItem Header="Kill" Command="{Binding Kill}" />
          <Separator />
          <MenuItem Header="Teleport">
            <MenuItem Header="Them to me" Command="{Binding TpToMe}" />
            <MenuItem Header="Me to them" Command="{Binding TpMeToThem}" />
            <MenuItem Header="Swap places" Command="{Binding TpSwap}" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Copy name" Command="{Binding CopyName}" />
          <MenuItem Header="Copy XUID" Command="{Binding CopyXuid}" />
          <Separator />
          <MenuItem Header="Kick" Command="{Binding Kick}" Visibility="{Binding IsHuman, Converter={StaticResource Vis}}" />
          <MenuItem Header="Ban (kick + refuse this session)" Command="{Binding Ban}" Foreground="{StaticResource Ng}" Visibility="{Binding IsHuman, Converter={StaticResource Vis}}" />
          <MenuItem Header="Unban" Command="{Binding Unban}" Visibility="{Binding IsBanned, Converter={StaticResource Vis}}" />
        </ContextMenu>
      </Border.ContextMenu>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center" Visibility="{Binding Alive, Converter={StaticResource Vis}}" ToolTip="alive" />
        <Ellipse Width="7" Height="7" Fill="{StaticResource Bd}" VerticalAlignment="Center" Visibility="{Binding Alive, Converter={StaticResource VisInv}}" ToolTip="dead / not spawned" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource Bd}" Visibility="{Binding Tag, Converter={StaticResource NullVis}}">
            <TextBlock Style="{StaticResource PillText}" Text="{Binding Tag}" Foreground="{StaticResource Dm}" />
          </Border>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource Wn}" Visibility="{Binding StageCode, Converter={StaticResource NullVis}}" ToolTip="staged for the next match">
            <TextBlock Style="{StaticResource PillText}" Text="{Binding StageCode}" Foreground="{StaticResource Wn}" />
          </Border>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource Ng}" Visibility="{Binding IsBanned, Converter={StaticResource Vis}}">
            <TextBlock Style="{StaticResource PillText}" Text="BANNED" Foreground="{StaticResource Ng}" />
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Flags}" Style="{StaticResource Dim}" FontSize="10" Margin="6,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Score}" FontSize="11" Margin="6,0" VerticalAlignment="Center" MinWidth="28" TextAlignment="Right" ToolTip="score" />
        <TextBlock Grid.Column="4" Text="{Binding Kd}" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" ToolTip="kills / deaths" />
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ═══ command queue row ═══ -->
  <DataTemplate DataType="{x:Type svc:QueuedCommand}">
    <Border Background="{StaticResource Sf}" BorderBrush="{StaticResource Bd}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,2,0,0" MinWidth="260">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Icon}" Foreground="{Binding State, Converter={StaticResource KeyBrush}}" FontWeight="Bold" Width="16" />
        <TextBlock Text="{Binding Label}" FontSize="11" Margin="4,0,8,0" />
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" FontSize="10" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- ═══ activity log row ═══ -->
  <DataTemplate DataType="{x:Type svc:LogEntry}">
    <Grid Margin="0,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Time}" Style="{StaticResource Dim}" FontSize="10" FontFamily="{StaticResource Mono}" />
      <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource KeyBrush}}" />
    </Grid>
  </DataTemplate>

  <!-- ═══ toast ═══ -->
  <DataTemplate DataType="{x:Type vm:ToastVM}">
    <Border Background="#F0141720" BorderBrush="{Binding Kind, Converter={StaticResource KeyBrush}}" BorderThickness="1,1,1,3" CornerRadius="6" Padding="12,8" Margin="0,4,0,0" MaxWidth="360">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
    </Border>
  </DataTemplate>

  <!-- ═══ map tile ═══ -->
  <DataTemplate DataType="{x:Type vm:MapTileVM}">
    <Button Command="{Binding DataContext.Maps.Select, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
            Width="150" Height="54" Margin="3" Padding="8,4" HorizontalContentAlignment="Left" ToolTip="{Binding Note}">
      <Button.Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Background" Value="{StaticResource Bg}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Ac}" />
              <Setter Property="Background" Value="{StaticResource AcDim}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLive}" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="110" />
          <TextBlock Text=" ● LIVE" Foreground="{StaticResource Ok}" FontSize="9" FontWeight="Bold" Visibility="{Binding IsLive, Converter={StaticResource Vis}}" VerticalAlignment="Center" />
          <TextBlock Text=" NEXT" Foreground="{StaticResource Wn}" FontSize="9" FontWeight="Bold" Visibility="{Binding IsStaged, Converter={StaticResource Vis}}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding Id}" Style="{StaticResource Dim}" FontSize="10" FontFamily="{StaticResource Mono}" />
      </StackPanel>
    </Button>
  </DataTemplate>

  <!-- ═══ playlist row ═══ -->
  <DataTemplate DataType="{x:Type vm:PlaylistRowVM}">
    <Border BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1" Padding="4,3">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="NEXT " Foreground="{StaticResource Wn}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding IsNext, Converter={StaticResource Vis}}" />
          <TextBlock Text="{Binding Map}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Gametype}" Style="{StaticResource Dim}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="⏭" Style="{StaticResource SmallBtn}" ToolTip="Set as next" Command="{Binding DataContext.Maps.SetNext, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" />
          <Button Content="↑" Style="{StaticResource SmallBtn}" Command="{Binding DataContext.Maps.MoveUp, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" />
          <Button Content="↓" Style="{StaticResource SmallBtn}" Command="{Binding DataContext.Maps.MoveDown, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" />
          <Button Content="✕" Style="{StaticResource SmallBtn}" Command="{Binding DataContext.Maps.Remove, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" Foreground="{StaticResource Ng}" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ═══ search hit ═══ -->
  <DataTemplate DataType="{x:Type vm:SearchHit}">
    <Button Command="{Binding DataContext.GoToHit, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
            HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,5">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Label}" FontSize="12" />
          <TextBlock Text="{Binding Sub}" Style="{StaticResource Dim}" FontFamily="{StaticResource Mono}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Where}" Style="{StaticResource Dim}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Button>
  </DataTemplate>

  <!-- ═══ perk row ═══ -->
  <DataTemplate DataType="{x:Type vm:PerkRowVM}">
    <CheckBox IsChecked="{Binding IsOn}" Margin="0,2,14,2" ToolTip="{Binding Note}" MinWidth="150">
      <TextBlock Text="{Binding Label}" FontSize="11" />
    </CheckBox>
  </DataTemplate>

</ResourceDictionary>
