<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GfPanel.ViewModels"
                    xmlns:svc="clr-namespace:GfPanel.Services"
                    xmlns:v="clr-namespace:GfPanel.Views">

  <v:BoolToVis x:Key="Vis" />
  <v:BoolToVis x:Key="VisInv" Invert="True" />
  <v:NullToVis x:Key="NullVis" />
  <v:NullToVis x:Key="NullVisInv" Invert="True" />
  <v:KeyToBrush x:Key="KeyBrush" />
  <v:TeamToBg x:Key="TeamBg" />
  <v:EffToBrush x:Key="EffBrush" />
  <v:HexToBrush x:Key="HexBrush" />
  <v:IntToString x:Key="IntStr" />
  <v:IntEquals x:Key="IntEq" />
  <v:NotConverter x:Key="Not" />
  <v:CountToVis x:Key="CountVis" />

  <!-- ═══ one settings row ═══ -->
  <DataTemplate DataType="{x:Type vm:SettingRowVM}">
    <StackPanel>
      <TextBlock Text="{Binding Group}" Style="{StaticResource SubTitle}" Visibility="{Binding HasGroup, Converter={StaticResource Vis}}" />
      <Grid Margin="0,1" MinHeight="30" ToolTip="{Binding Tip}" Background="Transparent">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding Dvar}" IsEnabled="False" />
            <MenuItem Header="Copy dvar name" Command="{Binding CopyCommand}" />
            <MenuItem Header="Pin / unpin (MATCH → ★ PINNED)" Command="{Binding PinCommand}" />
            <Separator />
            <MenuItem Header="Reset to default" Command="{Binding ResetCommand}" />
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource Star}" Content="{Binding StarGlyph}" Command="{Binding PinCommand}" ToolTip="Pin this setting to MATCH (★ PINNED SETTINGS)" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          <Border Style="{StaticResource Pill}" BorderBrush="{Binding EffLabel, Converter={StaticResource EffBrush}}" ToolTip="{Binding EffTip}">
            <TextBlock Style="{StaticResource PillText}" Text="{Binding EffLabel}" Foreground="{Binding EffLabel, Converter={StaticResource EffBrush}}" />
          </Border>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource Bd}" Visibility="{Binding ShowUnread, Converter={StaticResource Vis}}" ToolTip="No readback from the game has confirmed this value yet - the control shows the default / the last value sent.">
            <TextBlock Style="{StaticResource PillText}" Text="UNREAD" Foreground="{StaticResource Dm}" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
          <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsOn}" Visibility="{Binding IsToggle, Converter={StaticResource Vis}}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedChoice}" MinWidth="190" MaxWidth="290"
                    Visibility="{Binding IsChoice, Converter={StaticResource Vis}}" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsInt, Converter={StaticResource Vis}}">
            <Button Content="−" Style="{StaticResource SmallBtn}" Command="{Binding StepDown}" Width="24" Padding="0,2" />
            <TextBox Text="{Binding Value, Converter={StaticResource IntStr}, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="3,0" TextAlignment="Right" />
            <Button Content="+" Style="{StaticResource SmallBtn}" Command="{Binding StepUp}" Width="24" Padding="0,2" />
            <Button Content="Set" Style="{StaticResource SmallAccent}" Command="{Binding SetCommand}" Margin="4,0,0,0" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="3" Content="↺" Style="{StaticResource SmallBtn}" Command="{Binding ResetCommand}" ToolTip="Reset to the default and apply" Width="26" Padding="0,2" />
      </Grid>
    </StackPanel>
  </DataTemplate>

  <!-- ═══ a section block ═══ -->
  <DataTemplate DataType="{x:Type vm:SectionVM}">
    <Expander Style="{StaticResource Block}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
      <Expander.Header>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource Star}" Content="{Binding StarGlyph}" Command="{Binding PinCommand}" ToolTip="Pin this whole section to MATCH (★ PINNED SETTINGS)" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource BlockTitle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
          </StackPanel>
          <Button Grid.Column="2" Content="defaults" Style="{StaticResource SmallBtn}" Command="{Binding ResetAllCommand}" ToolTip="Reset every row in this section to its default" FontSize="10" Padding="6,1" />
        </Grid>
      </Expander.Header>
      <ItemsControl ItemsSource="{Binding Rows}" />
    </Expander>
  </DataTemplate>

  <!-- (a pinned group renders inside MATCH → ★ PINNED SETTINGS, which carries its own item template) -->

  <!-- ═══ a player row (sidebar) ═══
       bocw-84 2026-09-23 (klaze): "App needs to clearly show who has a client menu. give them a color with something to
       symbolize" - a purple ★ MENU badge + purple name; ⚒ FORGE for forge mode. The right-click menu leads with
       "Give client mod menu" (coloured) and groups the rest into Player / Loadout / Teleport / Team / Moderation.
       2026-09-24 redesign: the ☆ / ★ at the row's end gives / takes the menu in one click (klaze: one of the most-used
       jobs), and "Open on the PLAYERS page" shows every action as a button. The PLAYERS page's list uses this template
       too. -->
  <SolidColorBrush x:Key="MenuC" Color="#FFC77DFF" />
  <SolidColorBrush x:Key="MenuDim" Color="#29C77DFF" />
  <SolidColorBrush x:Key="ForgeC" Color="#FF46D2FF" />
  <SolidColorBrush x:Key="ForgeDim" Color="#2246D2FF" />
  <Style x:Key="CtxHead" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{StaticResource Dm}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <DataTemplate DataType="{x:Type vm:PlayerRowVM}">
    <Border Padding="4,3" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1" ToolTip="{Binding Xuid}">
      <Border.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background" Value="Transparent" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasMenu}" Value="True">
              <Setter Property="Background" Value="{StaticResource MenuDim}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{Binding Name}" Style="{StaticResource CtxHead}" />
          <MenuItem Header="🔎  Open on the PLAYERS page" Command="{Binding Inspect}" ToolTip="every action for this player as a button" />
          <MenuItem Command="{Binding ToggleMenu}" Visibility="{Binding ShowGiveMenu, Converter={StaticResource Vis}}" Foreground="{StaticResource MenuC}" FontWeight="Bold"
                    ToolTip="forgegrant on - their own mod menu (hold ADS + Melee, controller: D-pad up): Props / Vehicles, Player (god, ammo, 3rd person, fly, speed, operator, outfit), Teleport (to the host, to any player, crosshair, gun, save / load), Weapons, Camo. No admin. Survives rounds and a rejoin.">
            <MenuItem.Header>
              <TextBlock Foreground="{StaticResource MenuC}"><Run Text="★" FontSize="13" /><Run Text="  Give client mod menu" /></TextBlock>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem Command="{Binding ToggleMenu}" Visibility="{Binding ShowTakeMenu, Converter={StaticResource Vis}}" Foreground="{StaticResource MenuC}" ToolTip="forgegrant off">
            <MenuItem.Header>
              <TextBlock Foreground="{StaticResource MenuC}"><Run Text="✖" /><Run Text="  Take back client mod menu" /></TextBlock>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem Header="⚒  Forge mode" Foreground="{StaticResource ForgeC}" Visibility="{Binding IsHuman, Converter={StaticResource Vis}}">
            <MenuItem Header="On" Command="{Binding ForgeModeOn}" ToolTip="forgemode on - tap-to-grab prompts on props (ours + map props within the grab reach); move / turn / scale / delete them" />
            <MenuItem Header="Off" Command="{Binding ForgeModeOff}" ToolTip="forgemode off" />
          </MenuItem>
          <MenuItem Header="✉  Message…" Command="{Binding Message}" />
          <Separator />
          <MenuItem Header="♥  Player">
            <MenuItem Header="God mode" Command="{Binding GodMode}" />
            <MenuItem Header="Max ammo" Command="{Binding MaxAmmo}" />
            <MenuItem Header="Third person" Command="{Binding ThirdPersonCmd}" />
            <MenuItem Header="Fly" Command="{Binding FlyCmd}" />
            <MenuItem Header="Freeze / unfreeze" Command="{Binding Freeze}" />
            <MenuItem Header="Speed">
              <MenuItem Header="50%" Command="{Binding Speed50}" />
              <MenuItem Header="150%" Command="{Binding Speed150}" />
              <MenuItem Header="200%" Command="{Binding Speed200}" />
              <MenuItem Header="Back to global" Command="{Binding Speed0}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Kill" Command="{Binding Kill}" Foreground="{StaticResource Ng}" />
          </MenuItem>
          <MenuItem Header="🎒  Loadout">
            <MenuItem Header="Give the picked weapon (PLAYERS / SANDBOX pick)" Command="{Binding GiveWeapon}" />
            <MenuItem Header="Give streak">
              <MenuItem Header="RC-XD" Command="{Binding StreakRcxd}" ToolTip="streak recon_car - the stock care-package give; they use it with the normal streak button" />
              <MenuItem Header="Bow (Sparrow)" Command="{Binding StreakBow}" ToolTip="streak sig_bow_flame" />
              <MenuItem Header="Nuke" Command="{Binding StreakNuke}" ToolTip="streak nuke" />
              <Separator />
              <MenuItem Header="The one picked (PLAYERS / SANDBOX → STREAKS)" Command="{Binding StreakPicked}" />
            </MenuItem>
            <MenuItem Header="Give the picked perk (PLAYERS pick)" Command="{Binding GivePerks}" />
            <MenuItem Header="Cosmetics (ids from PLAYERS / SANDBOX)">
              <MenuItem Header="Camo" Command="{Binding Camo}" />
              <MenuItem Header="Operator" Command="{Binding Operator}" />
              <MenuItem Header="Outfit" Command="{Binding Outfit}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Take current weapon" Command="{Binding TakeWeapon}" />
            <MenuItem Header="Strip all weapons" Command="{Binding Strip}" />
          </MenuItem>
          <MenuItem Header="⌖  Teleport">
            <MenuItem Header="Bring them to me" Command="{Binding TpToMe}" />
            <MenuItem Header="Me to them" Command="{Binding TpMeToThem}" />
            <MenuItem Header="Swap places" Command="{Binding TpSwap}" />
            <Separator />
            <MenuItem Header="Them to player" ItemsSource="{Binding OtherPlayers}" ToolTip="tpto - move this player in front of the one you pick, facing them">
              <MenuItem.ItemContainerStyle>
                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                  <Setter Property="Header" Value="{Binding Name}" />
                  <Setter Property="Command" Value="{Binding Go}" />
                </Style>
              </MenuItem.ItemContainerStyle>
            </MenuItem>
          </MenuItem>
          <MenuItem Header="⚑  Team">
            <MenuItem Header="Move to allies" Command="{Binding MoveAllies}" />
            <MenuItem Header="Move to axis" Command="{Binding MoveAxis}" />
            <MenuItem Header="Move to spectator" Command="{Binding Spectate}" />
            <Separator />
            <MenuItem Header="Next match">
              <MenuItem Header="Stage: Allies" Command="{Binding StageA}" />
              <MenuItem Header="Stage: Axis" Command="{Binding StageX}" />
              <MenuItem Header="Stage: Spectator" Command="{Binding StageS}" />
              <MenuItem Header="Unstage" Command="{Binding StageClear}" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="🎉  Fun pack" Visibility="{Binding IsHuman, Converter={StaticResource Vis}}" ToolTip="the cloud branch's fun pack, aimed at this player (the GSC fun verb + gf_cmd_target); never run">
            <MenuItem Header="Fly bind (Tac + Melee)">
              <MenuItem Header="On" Command="{Binding Fun}" CommandParameter="flybind on" />
              <MenuItem Header="Off" Command="{Binding Fun}" CommandParameter="flybind off" />
            </MenuItem>
            <MenuItem Header="Slide preset" ToolTip="fun slidemode - this player's own slide (pers, survives rounds); the same rows are on a granted client's Player page">
              <MenuItem Header="Super Slide (150% + long slide)" Command="{Binding Fun}" CommandParameter="slidemode 1" />
              <MenuItem Header="Infinite Slide (glide 700 until JUMP)" Command="{Binding Fun}" CommandParameter="slidemode 2" />
              <MenuItem Header="Off (match settings)" Command="{Binding Fun}" CommandParameter="slidemode 0" />
            </MenuItem>
            <MenuItem Header="Random camo (once)" Command="{Binding Fun}" CommandParameter="camorandom" />
            <MenuItem Header="Disco camo">
              <MenuItem Header="On" Command="{Binding Fun}" CommandParameter="disco on" />
              <MenuItem Header="Off" Command="{Binding Fun}" CommandParameter="disco off" />
            </MenuItem>
            <MenuItem Header="Disguise">
              <MenuItem Header="Random prop" Command="{Binding Fun}" CommandParameter="disg random" />
              <MenuItem Header="Next prop" Command="{Binding Fun}" CommandParameter="disg next" />
              <MenuItem Header="Previous prop" Command="{Binding Fun}" CommandParameter="disg prev" />
              <MenuItem Header="Off" Command="{Binding Fun}" CommandParameter="disg off" />
            </MenuItem>
            <MenuItem Header="Prop gun">
              <MenuItem Header="On" Command="{Binding Fun}" CommandParameter="propgun on" />
              <MenuItem Header="Off" Command="{Binding Fun}" CommandParameter="propgun off" />
            </MenuItem>
            <MenuItem Header="Grenade swap">
              <MenuItem Header="On" Command="{Binding Fun}" CommandParameter="nadeswap on" />
              <MenuItem Header="Off" Command="{Binding Fun}" CommandParameter="nadeswap off" />
            </MenuItem>
            <MenuItem Header="Model cannon">
              <MenuItem Header="On" Command="{Binding Fun}" CommandParameter="cannon on" />
              <MenuItem Header="Off" Command="{Binding Fun}" CommandParameter="cannon off" />
            </MenuItem>
          </MenuItem>
          <Separator />
          <MenuItem Header="📜  Show their menu log" Command="{Binding ShowMenuLog}" Visibility="{Binding IsHuman, Converter={StaticResource Vis}}" ToolTip="ACTIVITY shows only this player's menu actions (the GFLOG menu log) - the 'All' chip clears it" />
          <MenuItem Header="⧉  Copy">
            <MenuItem Header="Name" Command="{Binding CopyName}" />
            <MenuItem Header="XUID" Command="{Binding CopyXuid}" />
          </MenuItem>
          <MenuItem Header="⛔  Moderation" Visibility="{Binding IsHuman, Converter={StaticResource Vis}}">
            <MenuItem Header="Kick" Command="{Binding Kick}" />
            <MenuItem Header="Ban (kick + refuse this session)" Command="{Binding Ban}" Foreground="{StaticResource Ng}" />
            <MenuItem Header="Unban" Command="{Binding Unban}" Visibility="{Binding IsBanned, Converter={StaticResource Vis}}" />
          </MenuItem>
        </ContextMenu>
      </Border.ContextMenu>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center" Visibility="{Binding Alive, Converter={StaticResource Vis}}" ToolTip="alive" />
        <Ellipse Width="7" Height="7" Fill="{StaticResource Bd}" VerticalAlignment="Center" Visibility="{Binding Alive, Converter={StaticResource VisInv}}" ToolTip="dead / not spawned" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasMenu}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MenuC}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource MenuC}" Background="{StaticResource MenuDim}" Visibility="{Binding HasMenu, Converter={StaticResource Vis}}"
                  ToolTip="Has a client mod menu (ADS + Melee in game; controller D-pad up). Right-click → Take back client mod menu.">
            <TextBlock Style="{StaticResource PillText}" Text="★ MENU" Foreground="{StaticResource MenuC}" />
          </Border>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource ForgeC}" Background="{StaticResource ForgeDim}" Visibility="{Binding ForgeMode, Converter={StaticResource Vis}}"
                  ToolTip="Forge mode: tap-to-grab prompts on props. Right-click → Forge mode → Off.">
            <TextBlock Style="{StaticResource PillText}" Text="⚒ FORGE" Foreground="{StaticResource ForgeC}" />
          </Border>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource Bd}" Visibility="{Binding Tag, Converter={StaticResource NullVis}}">
            <TextBlock Style="{StaticResource PillText}" Text="{Binding Tag}" Foreground="{StaticResource Dm}" />
          </Border>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource Wn}" Visibility="{Binding StageCode, Converter={StaticResource NullVis}}" ToolTip="staged for the next match">
            <TextBlock Style="{StaticResource PillText}" Text="{Binding StageCode}" Foreground="{StaticResource Wn}" />
          </Border>
          <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource Ng}" Visibility="{Binding IsBanned, Converter={StaticResource Vis}}">
            <TextBlock Style="{StaticResource PillText}" Text="BANNED" Foreground="{StaticResource Ng}" />
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Flags}" Style="{StaticResource Dim}" FontSize="10" Margin="6,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Score}" FontSize="11" Margin="6,0" VerticalAlignment="Center" MinWidth="28" TextAlignment="Right" ToolTip="score" />
        <TextBlock Grid.Column="4" Text="{Binding Kd}" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" ToolTip="kills / deaths" />
        <!-- one-click client menu: ☆ gives, ★ takes back (fixed-width column so the numbers stay aligned on host / bot rows) -->
        <Button Grid.Column="5" Content="{Binding MenuGlyph}" Command="{Binding ToggleMenu}" ToolTip="{Binding MenuTip}" Style="{StaticResource Star}" FontSize="13"
                Foreground="{StaticResource MenuC}" HorizontalAlignment="Right" Visibility="{Binding CanHaveMenu, Converter={StaticResource Vis}}" />
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ═══ a spawned entity (ENTITIES tab, bocw-84 2026-09-23) ═══ -->
  <DataTemplate DataType="{x:Type vm:EntityRowVM}">
    <Border Padding="6,4" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1" Background="Transparent" ToolTip="{Binding Where}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="140" /><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding KindText}" Style="{StaticResource Dim}" FontSize="10" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Owner}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="who placed it" />
        <TextBlock Grid.Column="3" Text="{Binding Dist}" FontSize="11" VerticalAlignment="Center" ToolTip="distance from the host (50-unit steps)" />
        <TextBlock Grid.Column="4" Text="{Binding Where}" Style="{StaticResource Dim}" FontSize="10" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" ToolTip="position x, y, z" />
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding EntNum, StringFormat='#{0}'}" Style="{StaticResource Dim}" FontSize="10" FontFamily="{StaticResource Mono}" ToolTip="entity number" />
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource Wn}" FontSize="10" FontWeight="Bold" Margin="6,0,0,0" />
        </StackPanel>
        <Button Grid.Column="6" Content="✕ Delete" Style="{StaticResource NgBtn}" Command="{Binding Delete}" Padding="8,2" Margin="8,0,0,0" ToolTip="entdel - the game re-checks it is one of ours and never deletes an occupied vehicle" />
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ═══ command queue row ═══ -->
  <DataTemplate DataType="{x:Type svc:QueuedCommand}">
    <Border Background="{StaticResource Sf}" BorderBrush="{StaticResource Bd}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,2,0,0" MinWidth="260">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Icon}" Foreground="{Binding State, Converter={StaticResource KeyBrush}}" FontWeight="Bold" Width="16" />
        <TextBlock Text="{Binding Label}" FontSize="11" Margin="4,0,8,0" />
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" FontSize="10" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- ═══ activity log row ═══ -->
  <DataTemplate DataType="{x:Type svc:LogEntry}">
    <Grid Margin="0,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Time}" Style="{StaticResource Dim}" FontSize="10" FontFamily="{StaticResource Mono}" />
      <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource KeyBrush}}" />
    </Grid>
  </DataTemplate>

  <!-- ═══ toast ═══ -->
  <DataTemplate DataType="{x:Type vm:ToastVM}">
    <Border Background="#F0141720" BorderBrush="{Binding Kind, Converter={StaticResource KeyBrush}}" BorderThickness="1,1,1,3" CornerRadius="6" Padding="12,8" Margin="0,4,0,0" MaxWidth="360">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
    </Border>
  </DataTemplate>

  <!-- ═══ map tile ═══ -->
  <DataTemplate DataType="{x:Type vm:MapTileVM}">
    <Button Command="{Binding DataContext.Maps.Select, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
            Width="150" Height="54" Margin="3" Padding="8,4" HorizontalContentAlignment="Left" ToolTip="{Binding Note}">
      <Button.Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Background" Value="{StaticResource Bg}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Ac}" />
              <Setter Property="Background" Value="{StaticResource AcDim}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLive}" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="110" />
          <TextBlock Text=" ● LIVE" Foreground="{StaticResource Ok}" FontSize="9" FontWeight="Bold" Visibility="{Binding IsLive, Converter={StaticResource Vis}}" VerticalAlignment="Center" />
          <TextBlock Text=" NEXT" Foreground="{StaticResource Wn}" FontSize="9" FontWeight="Bold" Visibility="{Binding IsStaged, Converter={StaticResource Vis}}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding Id}" Style="{StaticResource Dim}" FontSize="10" FontFamily="{StaticResource Mono}" />
      </StackPanel>
    </Button>
  </DataTemplate>

  <!-- ═══ playlist row ═══ -->
  <DataTemplate DataType="{x:Type vm:PlaylistRowVM}">
    <Border BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1" Padding="4,3">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="NEXT " Foreground="{StaticResource Wn}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding IsNext, Converter={StaticResource Vis}}" />
          <TextBlock Text="{Binding Map}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Gametype}" Style="{StaticResource Dim}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="⏭" Style="{StaticResource SmallBtn}" ToolTip="Set as next" Command="{Binding DataContext.Maps.SetNext, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" />
          <Button Content="↑" Style="{StaticResource SmallBtn}" Command="{Binding DataContext.Maps.MoveUp, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" />
          <Button Content="↓" Style="{StaticResource SmallBtn}" Command="{Binding DataContext.Maps.MoveDown, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" />
          <Button Content="✕" Style="{StaticResource SmallBtn}" Command="{Binding DataContext.Maps.Remove, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" Foreground="{StaticResource Ng}" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ═══ search hit ═══ -->
  <DataTemplate DataType="{x:Type vm:SearchHit}">
    <Button Command="{Binding DataContext.GoToHit, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
            HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,5">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Label}" FontSize="12" />
          <TextBlock Text="{Binding Sub}" Style="{StaticResource Dim}" FontFamily="{StaticResource Mono}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Where}" Style="{StaticResource Dim}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Button>
  </DataTemplate>

  <!-- ═══ perk row ═══ -->
  <DataTemplate DataType="{x:Type vm:PerkRowVM}">
