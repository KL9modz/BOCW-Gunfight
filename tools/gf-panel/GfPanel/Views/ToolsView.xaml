<UserControl x:Class="GfPanel.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GfPanel.Views">
  <UserControl.Resources>
    <Style x:Key="RowLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Dm}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="110" />
    </Style>
    <Style x:Key="Row" TargetType="{x:Type WrapPanel}">
      <Setter Property="Margin" Value="0,3" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
    <v:ColumnsPanel>

      <!-- EVERYONE / PLAYER STATE -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header><TextBlock Text="PLAYER STATE — EVERYONE" Style="{StaticResource BlockTitle}" /></Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="God mode" Style="{StaticResource RowLabel}" />
            <Button Content="ALL on" Style="{StaticResource OkBtn}" Command="{Binding Tools.GodAllOn}" Margin="0,0,4,0" />
            <Button Content="ALL off" Command="{Binding Tools.GodAllOff}" Margin="0,0,12,0" />
            <Button Content="host toggle" Style="{StaticResource Chip}" Command="{Binding Tools.GodMode}" ToolTip="godmode - the host's own toggle" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Max ammo" Style="{StaticResource RowLabel}" />
            <Button Content="ALL now" Command="{Binding Tools.AmmoAll}" Margin="0,0,12,0" ToolTip="every carried weapon incl. offhands, everyone alive" />
            <Button Content="host" Style="{StaticResource Chip}" Command="{Binding Tools.MaxAmmo}" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Third person" Style="{StaticResource RowLabel}" />
            <Button Content="ALL on" Command="{Binding Tools.ThirdAllOn}" Margin="0,0,4,0" />
            <Button Content="ALL off" Command="{Binding Tools.ThirdAllOff}" Margin="0,0,12,0" />
            <Button Content="host toggle" Style="{StaticResource Chip}" Command="{Binding Tools.ThirdPerson}" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Freeze" Style="{StaticResource RowLabel}" />
            <Button Content="ALL freeze" Style="{StaticResource WnBtn}" Command="{Binding Tools.FreezeAllOn}" Margin="0,0,4,0" />
            <Button Content="ALL unfreeze" Command="{Binding Tools.FreezeAllOff}" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Invisible" Style="{StaticResource RowLabel}" />
            <Button Content="hide everyone" Command="{Binding Tools.InvisOn}" Margin="0,0,4,0" ToolTip="hide() on every player model - players invisible to each other (untested)" />
            <Button Content="show" Command="{Binding Tools.InvisOff}" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Timescale" Style="{StaticResource RowLabel}" />
            <Slider Minimum="10" Maximum="300" Value="{Binding Tools.Timescale}" Width="160" VerticalAlignment="Center" />
            <TextBox Text="{Binding Tools.Timescale, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="6,0" />
            <Button Content="Set" Style="{StaticResource SmallAccent}" Command="{Binding Tools.SlowmoApply}" Margin="0,0,4,0" ToolTip="setslowmotion( 1, pct/100, 0.5 ) - the engine's slow-motion ramp (the final-killcam shape). Untested as a standing timescale." />
            <Button Content="↺ 100%" Style="{StaticResource SmallBtn}" Command="{Binding Tools.SlowmoReset}" />
          </WrapPanel>
          <TextBlock Text="Host tools" Style="{StaticResource SubTitle}" />
          <WrapPanel Style="{StaticResource Row}">
            <Button Content="Fly" Style="{StaticResource Chip}" Command="{Binding Tools.Fly}" Margin="0,2,4,2" ToolTip="fly (toggle) - speed in MOVEMENT" />
            <Button Content="Drop weapon" Style="{StaticResource Chip}" Command="{Binding Tools.DropWeapon}" Margin="0,2,4,2" />
            <Button Content="Unlock all" Style="{StaticResource Chip}" Command="{Binding Tools.UnlockAll}" Margin="0,2,4,2" ToolTip="best-effort" />
            <Button Content="Freeze toggle (menu verb)" Style="{StaticResource Chip}" Command="{Binding Tools.FreezeToggle}" Margin="0,2,4,2" />
            <Button Content="Fade probe" Style="{StaticResource Chip}" Command="{Binding Tools.FadeProbe}" Margin="0,2,4,2" ToolTip="fadeprobe - prints ONE stamped line on the feed and ONE in the centre; time each until it vanishes = the engine's hold. Set 'Menu repaint (ms)' (ADVANCED → IN-GAME MENU DISPLAY) just under the shorter one." />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- PERKS -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="PERKS — EVERYONE" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="a checked perk is given now and re-given every spawn; effect per perk unmeasured" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Tools.Perks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Select all perks" Style="{StaticResource SmallAccent}" Command="{Binding Tools.PerksAll}" Margin="0,0,6,0" ToolTip="perkall all - every perk in the grid, given now and re-given every spawn (needs the 03:40+ GSC build; an older one answers 'unknown perk all')" />
            <Button Content="Clear all perks" Style="{StaticResource SmallBtn}" Command="{Binding Tools.PerksClear}" Margin="0,0,10,0" />
            <TextBlock Text="per-player: right-click a player → Give the picked perk" Style="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Tools.Perks}" DisplayMemberPath="Label" SelectedValuePath="Def" SelectedValue="{Binding Tools.SelectedPerk}" Width="170" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <!-- FUN & VISION -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header><TextBlock Text="FUN &amp; VISION" Style="{StaticResource BlockTitle}" /></Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Vision set" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.VisionSets}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedVision}" Width="220" />
            <TextBox Text="{Binding Tools.VisionName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="6,0" ToolTip="or type any vision set name (a name the map lacks is a no-op)" />
            <Button Content="Apply" Style="{StaticResource SmallAccent}" Command="{Binding Tools.VisionApply}" Margin="0,0,4,0" />
            <Button Content="default" Style="{StaticResource SmallBtn}" Command="{Binding Tools.VisionDefault}" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Drunk mode" Style="{StaticResource RowLabel}" />
            <Button Content="on" Command="{Binding Tools.DrunkOn}" Margin="0,0,4,0" ToolTip="a mild continuous camera shake on every living player" />
            <Button Content="off" Command="{Binding Tools.DrunkOff}" Margin="0,0,12,0" />
            <Button Content="💥 Earthquake" Style="{StaticResource WnBtn}" Command="{Binding Tools.Quake}" ToolTip="one strong shake at every player" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Play sound" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.SoundList}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedSound}" Width="220" />
            <Button Content="Play to all" Style="{StaticResource SmallAccent}" Command="{Binding Tools.PlaySound}" Margin="6,0,0,0" ToolTip="playsoundtoplayer with a stock alias the MP scripts use" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- WEAPONS + COSMETICS -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header><TextBlock Text="WEAPONS &amp; COSMETICS" Style="{StaticResource BlockTitle}" /></Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Weapon" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.WeaponList}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedWeapon}" Width="260" />
            <Button Content="Give me" Style="{StaticResource SmallAccent}" Command="{Binding Tools.GiveHost}" Margin="6,0,4,0" />
            <Button Content="Give EVERYONE" Style="{StaticResource SmallBtn}" Command="{Binding Tools.GiveAll}" ToolTip="everyone alive gets it and switches to it (this life)" />
          </WrapPanel>
          <TextBlock Text="a player: right-click them → Give the picked weapon" Style="{StaticResource Dim}" FontSize="10.5" Margin="110,0,0,4" />
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Camo id" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.CamoNames}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedCamo}" Width="170" ToolTip="named ones; any id 0-149 in the box" />
            <TextBox Text="{Binding Tools.CamoId, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="6,0" />
            <Button Content="Set (host)" Style="{StaticResource SmallAccent}" Command="{Binding Tools.CamoHost}" ToolTip="camo on the host's current weapon; a player: right-click → Cosmetics → Camo" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Operator id" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.OperatorNames}" SelectedItem="{Binding Tools.SelectedOperator}" Width="170" />
            <TextBox Text="{Binding Tools.OperatorId, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="6,0" />
            <Button Content="Set (host)" Style="{StaticResource SmallAccent}" Command="{Binding Tools.OperatorHost}" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Outfit id" Style="{StaticResource RowLabel}" />
            <TextBox Text="{Binding Tools.OutfitId, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="0,0,6,0" ToolTip="0-23 per operator" />
            <Button Content="Set (host)" Style="{StaticResource SmallAccent}" Command="{Binding Tools.OutfitHost}" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- TELEPORT -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="TELEPORT" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="crosshair = where the host aims · saved point survives rounds · everyone never includes bots" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Everyone" Style="{StaticResource RowLabel}" />
            <Button Content="to me" Style="{StaticResource Chip}" Command="{Binding Tools.TpAllMe}" Margin="0,2,4,2" ToolTip="ring around the host + 1.5 s invulnerability (the double-elimination fix)" />
            <Button Content="to crosshair" Style="{StaticResource Chip}" Command="{Binding Tools.TpAllAim}" Margin="0,2,4,2" />
            <Button Content="to saved point" Style="{StaticResource Chip}" Command="{Binding Tools.TpAllSaved}" Margin="0,2,4,2" />
            <Button Content="to map centre" Style="{StaticResource Chip}" Command="{Binding Tools.TpAllCentre}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="My team" Style="{StaticResource RowLabel}" />
            <Button Content="to me" Style="{StaticResource Chip}" Command="{Binding Tools.TpTeamMe}" Margin="0,2,4,2" />
            <Button Content="to crosshair" Style="{StaticResource Chip}" Command="{Binding Tools.TpTeamAim}" Margin="0,2,12,2" />
            <TextBlock Text="Other team" Style="{StaticResource RowLabel}" MinWidth="0" Margin="0,0,6,0" />
            <Button Content="to me" Style="{StaticResource Chip}" Command="{Binding Tools.TpEnemyMe}" Margin="0,2,4,2" />
            <Button Content="to crosshair" Style="{StaticResource Chip}" Command="{Binding Tools.TpEnemyAim}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Me" Style="{StaticResource RowLabel}" />
            <Button Content="to crosshair" Style="{StaticResource Chip}" Command="{Binding Tools.TpMeAim}" Margin="0,2,4,2" />
            <Button Content="to saved point" Style="{StaticResource Chip}" Command="{Binding Tools.TpMeSaved}" Margin="0,2,4,2" />
            <Button Content="to map centre" Style="{StaticResource Chip}" Command="{Binding Tools.TpMeCentre}" Margin="0,2,12,2" />
            <Button Content="Save point = here" Style="{StaticResource SmallAccent}" Command="{Binding Tools.TpSave}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Toggles" Style="{StaticResource RowLabel}" />
            <Button Content="TP gun: host" Style="{StaticResource Chip}" Command="{Binding Tools.TpGunHost}" Margin="0,2,4,2" ToolTip="shots teleport the shooter to the impact point (the menu's next-item key is ATTACK, so the gun ignores shots while the in-game menu is open)" />
            <Button Content="TP gun: everyone" Style="{StaticResource Chip}" Command="{Binding Tools.TpGunAll}" Margin="0,2,4,2" />
            <Button Content="TP grenade: host" Style="{StaticResource Chip}" Command="{Binding Tools.TpNadeHost}" Margin="0,2,4,2" ToolTip="a thrown grenade teleports the thrower where it lands (the Gersh device)" />
            <Button Content="TP grenade: everyone" Style="{StaticResource Chip}" Command="{Binding Tools.TpNadeAll}" Margin="0,2,4,2" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- STREAKS (bocw-1c 2026-09-21) -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="STREAKS" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="killstreaks::give - the care-package path; used with the normal streak button · NEVER RUN" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Give to" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.StreakTargets}" DisplayMemberPath="Name" SelectedItem="{Binding Tools.StreakTarget}" Width="200" Margin="0,0,6,0" ToolTip="a human in the match; empty = you (the host)" />
            <Button Content="RC-XD" Style="{StaticResource SmallAccent}" Command="{Binding Tools.StreakRcxd}" Margin="0,0,4,0" ToolTip="streak recon_car" />
            <Button Content="Bow (Sparrow)" Style="{StaticResource SmallAccent}" Command="{Binding Tools.StreakBow}" Margin="0,0,4,0" ToolTip="streak sig_bow_flame" />
            <Button Content="Nuke" Style="{StaticResource NgBtn}" Command="{Binding Tools.StreakNuke}" ToolTip="streak nuke" />
            <TextBlock Text="also: right-click a player → Give streak" Style="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Any streak" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.StreakList}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedStreak}" Width="220" Margin="0,0,6,0" ToolTip="the full stock set (streak_master): UAV, H.A.R.P., care package, armor, turrets, napalm, artillery, cruise missile, air patrol, strafe run, attack heli, VTOL, chopper gunner, gunship, war machine, hand cannon, death machine, flamethrower, ray gun…" />
            <Button Content="Give" Style="{StaticResource SmallAccent}" Command="{Binding Tools.StreakGive}" ToolTip="streak &lt;kstype&gt; to the picked player (or you)" />
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- VEHICLES -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="VEHICLES" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="{Binding Tools.VehicleNote}" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Drivable" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.DrivableVehicles}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedVehicle}" Width="260" />
            <Button Content="Spawn ahead of me" Style="{StaticResource SmallAccent}" Command="{Binding Tools.VehSpawn}" Margin="6,0,0,0" ToolTip="vehspawn &lt;index&gt; - isassetloaded-gated; aircraft above the host; a non-resident class just says so" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Other" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.OtherVehicles}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedOtherVehicle}" Width="260" />
            <Button Content="Spawn (untested)" Style="{StaticResource SmallBtn}" Command="{Binding Tools.VehSpawnOther}" Margin="6,0,0,0" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="" Style="{StaticResource RowLabel}" />
            <Button Content="Enter the vehicle I aim at" Style="{StaticResource Chip}" Command="{Binding Tools.VehEnter}" Margin="0,2,4,2" />
            <Button Content="Livery ◀" Style="{StaticResource Chip}" Command="{Binding Tools.VehLiveryPrev}" Margin="0,2,4,2" ToolTip="vehlivery prev - the previous model variant of the same body (T-72 Dead Ops colours, sedan police / KGB, van colours, FAV black, Hind, truck canvas / flatbed): the vehicle you sit in, else the one aimed at / nearest within 300 u. Feed ack names the variant; 'none on this map' if the body has no variants resident." />
            <Button Content="Livery ▶" Style="{StaticResource Chip}" Command="{Binding Tools.VehLiveryNext}" Margin="0,2,10,2" ToolTip="vehlivery next" />
            <Button Content="Delete all vehicles" Style="{StaticResource NgBtn}" Command="{Binding Tools.VehClear}" Margin="0,2,4,2" ToolTip="vehclear all - deletes every vehicle the menu / app spawned that is EMPTY; an occupied one is never deleted (get out first). Do this before any map switch." />
          </WrapPanel>
          <TextBlock Text="spawn-riding modes: ADVANCED → VEHICLE MODE" Style="{StaticResource Dim}" FontSize="10.5" Margin="110,2,0,0" />
        </StackPanel>
      </Expander>

      <!-- MAP TOYS -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="MAP TOYS" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="destructibles · radiant exploders · projectiles · props" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Destructibles" Style="{StaticResource RowLabel}" />
            <Button Content="break aimed" Style="{StaticResource Chip}" Command="{Binding Tools.DestructAim}" Margin="0,2,4,2" />
            <Button Content="break near me (600u)" Style="{StaticResource Chip}" Command="{Binding Tools.DestructNear}" Margin="0,2,4,2" />
            <Button Content="break ALL" Style="{StaticResource Chip}" Command="{Binding Tools.DestructAll}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Exploders" Style="{StaticResource RowLabel}" />
            <Button Content="fire next" Style="{StaticResource Chip}" Command="{Binding Tools.ExpNext}" Margin="0,2,4,2" />
            <Button Content="previous" Style="{StaticResource Chip}" Command="{Binding Tools.ExpPrev}" Margin="0,2,4,2" />
            <Button Content="again" Style="{StaticResource Chip}" Command="{Binding Tools.ExpAgain}" Margin="0,2,4,2" />
            <Button Content="stop current" Style="{StaticResource Chip}" Command="{Binding Tools.ExpStop}" Margin="0,2,4,2" />
            <Button Content="fire ALL (0.5 s apart)" Style="{StaticResource Chip}" Command="{Binding Tools.ExpAll}" Margin="0,2,4,2" />
            <Button Content="stop walk" Style="{StaticResource Chip}" Command="{Binding Tools.ExpStopAll}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Projectiles" Style="{StaticResource RowLabel}" />
            <Button Content="host" Style="{StaticResource Chip}" Command="{Binding Tools.ProjHost}" Margin="0,2,4,2" ToolTip="every shot also fires the chosen projectile down the aim line" />
            <Button Content="everyone" Style="{StaticResource Chip}" Command="{Binding Tools.ProjAll}" Margin="0,2,4,2" />
            <Button Content="OFF" Style="{StaticResource Chip}" Command="{Binding Tools.ProjOff}" Margin="0,2,12,2" />
            <Button Content="homing" Style="{StaticResource Chip}" Command="{Binding Tools.ProjHoming}" Margin="0,2,4,2" ToolTip="lock the enemy the shooter faces" />
            <Button Content="trail FX" Style="{StaticResource Chip}" Command="{Binding Tools.ProjTrail}" Margin="0,2,4,2" />
            <Button Content="PROJ debug line" Style="{StaticResource Chip}" Command="{Binding Tools.ProjDebug}" Margin="0,2,4,2" ToolTip="projdbg - the PROJ debug feed line (bocw-c7's diagnostic)" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Tools.ProjectileList}" DisplayMemberPath="Label" SelectedItem="{Binding Tools.SelectedProjectile}" Width="230" />
            <Button Content="Set projectile" Style="{StaticResource SmallAccent}" Command="{Binding Tools.ProjWeapon}" Margin="6,0,12,0" />
            <TextBlock Text="rate ms" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Tools.ProjRates}" SelectedItem="{Binding Tools.ProjRate}" Width="70" />
            <Button Content="Set" Style="{StaticResource SmallBtn}" Command="{Binding Tools.ProjRateSet}" Margin="4,0,12,0" />
            <TextBlock Text="method" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="projmethod 0-6 - 0 = AUTO (the GSC picks per weapon), 1-6 the spawn-method variants under test" />
            <ComboBox ItemsSource="{Binding Tools.ProjMethods}" SelectedItem="{Binding Tools.ProjMethod}" Width="50" />
            <Button Content="Set" Style="{StaticResource SmallBtn}" Command="{Binding Tools.ProjMethodSet}" Margin="4,0,0,0" />
          </WrapPanel>
          <TextBlock Text="props + explosive barrels: the PROPS block (the whole catalog, favourites for the in-game menu)" Style="{StaticResource Dim}" FontSize="10.5" Margin="110,2,0,0" />
        </StackPanel>
      </Expander>


      <!-- PROPS (docs/notes/prop-catalog.md) -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="PROPS &amp; EXPLOSIVE BARRELS" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="{Binding Props.LoadNote}" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <RadioButton Content="Universal (every map)" IsChecked="{Binding Props.ShowUniversal}" Margin="0,0,12,0" />
            <RadioButton IsChecked="{Binding Props.ShowMap}" Margin="0,0,12,0">
              <TextBlock Text="{Binding Props.MapLabel, StringFormat='This map: {0}'}" FontSize="11" />
            </RadioButton>
            <CheckBox Content="barrels only" IsChecked="{Binding Props.BarrelsOnly}" Margin="0,0,12,0" />
            <TextBox Text="{Binding Props.Search, UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="filter by model / label" />
            <TextBlock Text="{Binding Props.CountText}" Style="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>
          <ListBox ItemsSource="{Binding Props.Results}" SelectedItem="{Binding Props.Selected}" Height="220" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Background="{StaticResource Bg}" BorderBrush="{StaticResource Bd}" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Model}">
                  <TextBlock Text="{Binding Display}" FontSize="11.5" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Style="{StaticResource Row}">
            <Button Content="Place as prop" Style="{StaticResource SmallAccent}" Command="{Binding Props.SpawnProp}" Margin="0,2,4,2" ToolTip="where the host looks (propidx / propname)" />
            <Button Content="🛢 Place as EXPLOSIVE barrel" Style="{StaticResource WnBtn}" Command="{Binding Props.SpawnBarrel}" Margin="0,2,12,2" ToolTip="barrelidx / barrelname - shoot it to blow it up (radius ~260, damage 25-200)" />
            <TextBlock Text="scale %" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="per-map (by-name) spawns only" />
            <TextBox Text="{Binding Props.Scale, UpdateSourceTrigger=PropertyChanged}" Width="46" Margin="0,0,12,0" />
            <Button Content="☆ favourite" Style="{StaticResource SmallBtn}" Command="{Binding Props.ToggleFav}" Margin="0,2,12,2" ToolTip="a universal prop the in-game menu's Props page shows" />
            <Button Content="Remove last" Style="{StaticResource SmallBtn}" Command="{Binding Props.Undo}" Margin="0,2,4,2" />
            <Button Content="Delete all props" Style="{StaticResource NgBtn}" Command="{Binding Forge.Clear}" Margin="0,2,4,2" ToolTip="forge clear - every placed prop AND the saved forge layout for this map (propclear alone only deletes the live entities and the saved ones come back next round)" />
          </WrapPanel>
          <TextBlock Text="{Binding Props.FavText}" Style="{StaticResource SubTitle}" />
          <ItemsControl ItemsSource="{Binding Props.Favorites}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Bd}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,4,2">
                  <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding Display}" Style="{StaticResource Star}" Width="Auto" Foreground="{StaticResource Tx}" Command="{Binding DataContext.Props.SpawnFav, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Model}" />
                    <Button Content="✕" Style="{StaticResource Star}" Command="{Binding DataContext.Props.RemoveFav, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Push favourites to the in-game menu" Style="{StaticResource SmallAccent}" Command="{Binding Props.PushFavs}" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="set gf_prop_favs / gf_prop_favs2 (CSV of universal indices) + propfavs - the menu's Props → Favourites page" />
        </StackPanel>
      </Expander>

      <!-- FORGE + HINT BAR (forge-system session 2026-09-20, docs/notes/forge.md) -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="FORGE &amp; HINT BAR" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="in-game prop placer (host's body) + the hint-bar lines · NEVER RUN" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <TextBlock Text="PLACE MODE" Style="{StaticResource SubTitle}" />
          <WrapPanel>
            <Button Content="▶ Enter forge" Style="{StaticResource Accent}" Command="{Binding Forge.Enter}" Margin="0,0,6,4" ToolTip="forge enter - a ghost of the current model rides your crosshair onto surfaces while you walk normally (WASD / stick). D-pad or Action Slots 1-4: distance up/down, rotate left/right · ADS + up/down: scale · weapon switch: cycle model · FIRE: place · FRAG: exit - same on controller and keyboard. Weapons off while active." />
            <Button Content="■ Exit" Command="{Binding Forge.Exit}" Margin="0,0,6,4" ToolTip="forge exit - drop the preview, weapons back" />
            <Button Content="Place" Command="{Binding Forge.Place}" Margin="0,0,6,4" ToolTip="forge place - drop the preview where it is (same as FIRE in place mode)" />
            <Button Content="◀ Prev" Command="{Binding Forge.Prev}" Margin="0,0,6,4" ToolTip="forge prev - previous model in the universal list" />
            <Button Content="Next ▶" Command="{Binding Forge.Next}" Margin="0,0,6,4" ToolTip="forge next - next model" />
            <Button Content="Clear layout" Style="{StaticResource NgBtn}" Command="{Binding Forge.Clear}" Margin="0,0,6,4" ToolTip="forge clear - every placed prop AND the saved layout for this map (game.gf_forge). Placed props otherwise re-appear every round." />
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}" FontSize="10.5" Margin="0,2,0,8">Placed props join the props list (Undo / Remove all above work on them) and persist across rounds on this map. Edit-placed (select / nudge / rotate / delete) and layout save/load = phase 2, not built.</TextBlock>

          <TextBlock Text="FORGE MODE — GRAB + EDIT PROPS" Style="{StaticResource SubTitle}" />
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Me (host)" Style="{StaticResource RowLabel}" />
            <Button Content="On" Style="{StaticResource SmallAccent}" Command="{Binding Forge.ModeHostOn}" Margin="0,0,4,0" ToolTip="forgemode on - tap-to-grab prompts on props (ours + map props within Grab reach) and move / turn / scale / delete; nobody else sees the prompts" />
            <Button Content="Off" Style="{StaticResource SmallBtn}" Command="{Binding Forge.ModeHostOff}" Margin="0,0,12,0" />
            <TextBlock Text="Everyone" Style="{StaticResource RowLabel}" />
            <Button Content="On" Style="{StaticResource SmallAccent}" Command="{Binding Forge.ModeAllOn}" Margin="0,0,4,0" ToolTip="forgemode all on" />
            <Button Content="Off" Style="{StaticResource SmallBtn}" Command="{Binding Forge.ModeAllOff}" ToolTip="forgemode all off" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="A player" Style="{StaticResource RowLabel}" />
            <ComboBox ItemsSource="{Binding Forge.Humans}" DisplayMemberPath="Name" SelectedItem="{Binding Forge.GrantTarget}" Width="200" Margin="0,0,6,0" ToolTip="humans in the match (not you)" />
            <Button Content="On" Style="{StaticResource SmallAccent}" Command="{Binding Forge.ModeTargetOn}" Margin="0,0,4,0" />
            <Button Content="Off" Style="{StaticResource SmallBtn}" Command="{Binding Forge.ModeTargetOff}" />
            <TextBlock Text="also: right-click a player → Forge mode" Style="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>

          <TextBlock Text="GIVE A PLAYER THEIR OWN CLIENT MENU" Style="{StaticResource SubTitle}" />
          <WrapPanel Style="{StaticResource Row}">
            <ComboBox ItemsSource="{Binding Forge.Humans}" DisplayMemberPath="Name" SelectedItem="{Binding Forge.GrantTarget}" Width="200" Margin="0,0,6,0" ToolTip="humans in the match (not you)" />
            <Button Content="Give client menu" Style="{StaticResource SmallAccent}" Command="{Binding Forge.GrantOn}" Margin="0,0,4,0" ToolTip="forgegrant on - their own mini mod-menu (hold ADS + Melee): Forge / Props / Vehicles, God / Ammo / 3rd person / Fly / Unlock, Teleport (me to host / crosshair / save / load), Weapons / Camo / Operator / Outfit, Display. No admin, no globals. NEVER RUN for a non-host; may need re-granting after a round (v2: persistence, personal speed / jump, me-to-a-player, teleport gun)." />
            <Button Content="Revoke" Style="{StaticResource SmallBtn}" Command="{Binding Forge.GrantOff}" ToolTip="forgegrant off" />
            <TextBlock Text="also: right-click a player → Client menu" Style="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>

          <TextBlock Text="HINT BAR — LINES" Style="{StaticResource SubTitle}" />
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Others see" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" ToolTip="the one outward-facing line: what other players read when they approach you (per-player hint trigger, you excluded), always - no automatic build warning; ^colour codes work; up to 102 chars, sent as 3 chunks" />
            <TextBox Grid.Column="1" Text="{Binding Forge.OthersText, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding Forge.MaxHintChars}" />
            <Button Grid.Column="2" Content="Set" Style="{StaticResource SmallAccent}" Command="{Binding Forge.SetOthers}" Margin="4,0,0,0" ToolTip="gf_ho0/1/2 + hintset others" />
          </Grid>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Menu legend" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" ToolTip="the controls line the hint bar shows while the in-game menu is open (gf_hint_nav) - one 31-char line" />
            <TextBox Grid.Column="1" Text="{Binding Forge.NavText, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding Forge.MaxNavChars}" />
            <Button Grid.Column="2" Content="Set" Style="{StaticResource SmallBtn}" Command="{Binding Forge.SetNav}" Margin="4,0,0,0" ToolTip="set gf_hint_nav (fits the 47-byte slot: 31 chars)" />
          </Grid>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}" FontSize="10.5" Margin="0,4,0,0">The on/off for the others line and the bind-glyph test are settings: ADVANCED → IN-GAME MENU DISPLAY.</TextBlock>
        </StackPanel>
      </Expander>

      <!-- FORGE CONTROLS - a data-driven settings section (Schema.cs, Tab = "tools") so the rows get readback + pills -->
      <ItemsControl ItemsSource="{Binding ToolsSections}" />

      <!-- RACE -->
      <Expander Style="{StaticResource Block}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="RACE" Style="{StaticResource BlockTitle}" />
            <TextBlock Text="a Free-for-all match; gates go where the host stands, across his travel; settings in ADVANCED → RACE SETTINGS" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Track" Style="{StaticResource RowLabel}" />
            <Button Content="gate here" Style="{StaticResource Chip}" Command="{Binding Tools.RaceGate}" Margin="0,2,4,2" ToolTip="the first gate is start/finish" />
            <Button Content="undo last gate" Style="{StaticResource Chip}" Command="{Binding Tools.RaceUndo}" Margin="0,2,4,2" />
            <Button Content="clear track" Style="{StaticResource Chip}" Command="{Binding Tools.RaceClear}" Margin="0,2,4,2" />
            <Button Content="load the game's saved track" Style="{StaticResource Chip}" Command="{Binding Tools.RaceLoad}" Margin="0,2,4,2" />
            <Button Content="markers show/hide" Style="{StaticResource Chip}" Command="{Binding Tools.RaceMarkers}" Margin="0,2,4,2" />
            <Button Content="reset me" Style="{StaticResource Chip}" Command="{Binding Tools.RaceResetMe}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Race" Style="{StaticResource RowLabel}" />
            <Button Content="START RACE (3-2-1-GO)" Style="{StaticResource OkBtn}" Command="{Binding Tools.RaceStart}" Margin="0,2,4,2" />
            <Button Content="Stop / cancel" Style="{StaticResource WnBtn}" Command="{Binding Tools.RaceStop}" Margin="0,2,4,2" />
            <Button Content="END MATCH (podium)" Style="{StaticResource NgBtn}" Command="{Binding Tools.RaceEndMatch}" Margin="0,2,4,2" />
          </WrapPanel>
          <WrapPanel Style="{StaticResource Row}">
            <TextBlock Text="Saved tracks" Style="{StaticResource RowLabel}" />
            <TextBox Text="{Binding Tools.TrackName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,4,0" />
            <Button Content="Save track from game" Style="{StaticResource SmallAccent}" Command="{Binding Tools.TrackSave}" Margin="0,0,12,0" ToolTip="reads the gates the game publishes (GFCFG trk=) into tracks.json" />
            <ComboBox ItemsSource="{Binding Tools.SavedTracks}" SelectedItem="{Binding Tools.SelectedTrack}" Width="230" />
            <Button Content="Load into game" Style="{StaticResource SmallBtn}" Command="{Binding Tools.TrackLoad}" Margin="4,0,4,0" ToolTip="racetrack &lt;map&gt; then one racegate per gate, 0.5 s apart" />
            <Button Content="Delete" Style="{StaticResource SmallBtn}" Command="{Binding Tools.TrackDelete}" />
          </WrapPanel>
        </StackPanel>
      </Expander>

    </v:ColumnsPanel>
  </ScrollViewer>
</UserControl>
