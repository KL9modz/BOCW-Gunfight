<UserControl x:Class="GfPanel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GfPanel.Views">
  <UserControl.Resources>
    <v:BindingProxy x:Key="Proxy" Data="{Binding}" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
    <StackPanel>
      <!-- ONE column flow: the data-driven settings blocks (GUNFIGHT MATCH, LOADOUT & CAMO, OVERTIME ZONE,
           BOTS, CUSTOM BOT TUNING, MOVEMENT) followed by the fixed blocks, so the fixed ones fill the
           shortest columns instead of starting a second row under the tallest column -->
      <v:ColumnsPanel>
        <v:ColumnsPanel.ItemsSource>
          <CompositeCollection>
            <CollectionContainer Collection="{Binding Data.DashboardSections, Source={StaticResource Proxy}}" />
        <!-- BOTS: verbs + presets + profiles -->
        <Expander Style="{StaticResource Block}">
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="BOTS — ACTIONS &amp; PROFILES" Style="{StaticResource BlockTitle}" />
              <TextBlock Text="{Binding Bots.LiveDifficulty, StringFormat='live difficulty: {0}'}" Style="{StaticResource Dim}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Expander.Header>
          <StackPanel>
            <WrapPanel Margin="0,2">
              <Button Content="+ Add bot (auto)" Style="{StaticResource Chip}" Command="{Binding Bots.AddAuto}" Margin="0,2,4,2" ToolTip="addbot auto - the smaller side, tie = opposite the host" />
              <Button Content="+ Allies" Style="{StaticResource Chip}" Command="{Binding Bots.AddAllies}" Margin="0,2,4,2" />
              <Button Content="+ Axis" Style="{StaticResource Chip}" Command="{Binding Bots.AddAxis}" Margin="0,2,4,2" />
              <Button Content="− Remove one" Style="{StaticResource Chip}" Command="{Binding Bots.RemoveOne}" Margin="0,2,4,2" />
              <Button Content="⚖ Even up" Style="{StaticResource Chip}" Command="{Binding Bots.EvenUp}" Margin="0,2,4,2" ToolTip="evenbots - the fewest bots that make the sides equal (an odd human count)" />
              <Button Content="Fill" Style="{StaticResource Chip}" Command="{Binding Bots.Fill}" Margin="0,2,4,2" />
              <Button Content="Remove all" Style="{StaticResource Chip}" Command="{Binding Bots.RemoveAll}" Margin="0,2,4,2" />
            </WrapPanel>
            <TextBlock Text="Difficulty — both sides" Style="{StaticResource SubTitle}" />
            <WrapPanel>
              <Button Content="RECRUIT" Style="{StaticResource Chip}" Command="{Binding Bots.SetBoth}" CommandParameter="0" Margin="0,2,4,2" />
              <Button Content="REGULAR" Style="{StaticResource Chip}" Command="{Binding Bots.SetBoth}" CommandParameter="1" Margin="0,2,4,2" />
              <Button Content="HARDENED" Style="{StaticResource Chip}" Command="{Binding Bots.SetBoth}" CommandParameter="2" Margin="0,2,4,2" />
              <Button Content="VETERAN" Style="{StaticResource Chip}" Command="{Binding Bots.SetBoth}" CommandParameter="3" Margin="0,2,4,2" />
              <Button Content="CUSTOM" Style="{StaticResource Chip}" Command="{Binding Bots.SetBoth}" CommandParameter="4" Margin="0,2,4,2" ToolTip="the CUSTOM BOT TUNING knobs, both sides" />
              <Button Content="LOBBY'S" Style="{StaticResource Chip}" Command="{Binding Bots.SetBoth}" CommandParameter="-1" Margin="0,2,4,2" ToolTip="hand both rows back to the custom-games menu (-1)" />
            </WrapPanel>
            <TextBlock Text="Custom presets (the GSC's four) — sets CUSTOM on both sides" Style="{StaticResource SubTitle}" />
            <WrapPanel>
              <Button Content="Veteran+" Style="{StaticResource Chip}" Command="{Binding Bots.ApplyPreset}" CommandParameter="Veteran+ (custom default)" Margin="0,2,4,2" />
              <Button Content="Godlike" Style="{StaticResource Chip}" Command="{Binding Bots.ApplyPreset}" CommandParameter="Godlike" Margin="0,2,4,2" />
              <Button Content="Stock Veteran copy" Style="{StaticResource Chip}" Command="{Binding Bots.ApplyPreset}" CommandParameter="Stock Veteran copy" Margin="0,2,4,2" />
              <Button Content="Potato" Style="{StaticResource Chip}" Command="{Binding Bots.ApplyPreset}" CommandParameter="Potato" Margin="0,2,4,2" />
            </WrapPanel>
            <TextBlock Text="Named profiles (the 15 knobs, saved by the panel)" Style="{StaticResource SubTitle}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding Bots.Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding Bots.SelectedProfile}" />
              <Button Grid.Column="1" Content="Apply" Style="{StaticResource SmallAccent}" Command="{Binding Bots.ApplyProfile}" Margin="4,0,0,0" />
              <Button Grid.Column="2" Content="Save as" Style="{StaticResource SmallBtn}" Command="{Binding Bots.SaveProfile}" Margin="4,0,0,0" ToolTip="Save the current CUSTOM BOT TUNING values under a name" />
              <Button Grid.Column="3" Content="Del" Style="{StaticResource SmallBtn}" Command="{Binding Bots.DeleteProfile}" Margin="4,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding Bots.ProfileNote}" Style="{StaticResource Dim}" FontSize="10.5" Margin="0,3,0,0" />
          </StackPanel>
        </Expander>

        <!-- MESSAGE COMPOSER -->
        <Expander Style="{StaticResource Block}">
          <Expander.Header>
            <TextBlock Text="MESSAGES — BROADCAST" Style="{StaticResource BlockTitle}" />
          </Expander.Header>
          <StackPanel>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Channel" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="Centre" IsChecked="{Binding Message.Loc, Converter={StaticResource IntEq}, ConverterParameter=0}" Margin="0,0,10,0" />
                <RadioButton Content="Feed" IsChecked="{Binding Message.Loc, Converter={StaticResource IntEq}, ConverterParameter=1}" Margin="0,0,10,0" />
                <RadioButton Content="Banner (held)" IsChecked="{Binding Message.Loc, Converter={StaticResource IntEq}, ConverterParameter=2}" ToolTip="the persistent hint line, held until Clear" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="Duration" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="12,0,6,0" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding Message.Durations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Message.Dur}" Width="80" IsEnabled="{Binding Message.IsBanner, Converter={StaticResource Not}}" />
            </Grid>
            <TextBlock Text="{Binding Message.DurationNote}" Style="{StaticResource Dim}" FontSize="10" Margin="0,0,0,4" />
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="To" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Message.AudienceChoices}" Text="{Binding Message.Audience}" IsEditable="True" />
              <TextBlock Grid.Column="2" Text="Indent" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="12,0,6,0" Visibility="{Binding Message.IsBanner, Converter={StaticResource Vis}}" />
              <TextBox Grid.Column="3" Text="{Binding Message.Indent, UpdateSourceTrigger=PropertyChanged}" Width="44" Visibility="{Binding Message.IsBanner, Converter={StaticResource Vis}}" />
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="MsgBox" Text="{Binding Message.Text, UpdateSourceTrigger=PropertyChanged}" KeyDown="MsgBox_KeyDown" />
              <TextBlock Grid.Column="1" Text="{Binding Message.CharsLeft}" Style="{StaticResource Dim}" FontSize="10" VerticalAlignment="Center" Margin="6,0" ToolTip="characters left (the 47-byte bridge slot caps a message at 30)" />
              <Button Grid.Column="2" Content="Send" Style="{StaticResource SmallAccent}" Command="{Binding Message.Send}" />
              <Button Grid.Column="3" Content="Clear" Style="{StaticResource SmallBtn}" Command="{Binding Message.Clear}" Margin="4,0,0,0" ToolTip="stop a held broadcast / banner" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Message.Colors}" Margin="0,4">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="22" Height="18" Padding="0" Margin="0,0,3,0" Background="{Binding Hex, Converter={StaticResource HexBrush}}" BorderBrush="#66000000"
                          ToolTip="{Binding Name}" Command="{Binding DataContext.Message.InsertColor, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Code}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Preset" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Message.Presets}" DisplayMemberPath="Name" SelectedItem="{Binding Message.SelectedPreset}" />
              <Button Grid.Column="2" Content="Save" Style="{StaticResource SmallBtn}" Command="{Binding Message.SavePreset}" Margin="4,0,0,0" />
              <Button Grid.Column="3" Content="Del" Style="{StaticResource SmallBtn}" Command="{Binding Message.DeletePreset}" Margin="4,0,0,0" />
            </Grid>
            <WrapPanel Margin="0,4,0,0">
              <Button Content="5..1 GO countdown" Style="{StaticResource Chip}" Command="{Binding Message.Countdown}" Margin="0,0,4,0" />
              <Button Content="Announce settings" Style="{StaticResource Chip}" Command="{Binding Message.Announce}" ToolTip="announce - the mod's settings summary to everyone" />
            </WrapPanel>
          </StackPanel>
        </Expander>

        <!-- CONFIG PRESETS -->
        <Expander Style="{StaticResource Block}">
          <Expander.Header>
            <TextBlock Text="CONFIG PRESETS" Style="{StaticResource BlockTitle}" />
          </Expander.Header>
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}" FontSize="10.5" Margin="0,0,0,6">A snapshot of every setting under a name (the rcon tool's "Save to cfg"). Applying sends only the fields that differ from the live values.</TextBlock>
            <Button Content="💾 Save current settings as preset…" Command="{Binding SavePreset}" HorizontalAlignment="Left" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding ConfigPresets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}" FontSize="10" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Apply" Style="{StaticResource SmallAccent}" Command="{Binding DataContext.ApplyPresetCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Content="✕" Style="{StaticResource SmallBtn}" Command="{Binding DataContext.DeletePresetCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="4,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
          </CompositeCollection>
        </v:ColumnsPanel.ItemsSource>
      </v:ColumnsPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
