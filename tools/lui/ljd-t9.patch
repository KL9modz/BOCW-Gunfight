--- a/ljd/rawdump/constants.py
+++ b/ljd/rawdump/constants.py
@@ -6,6 +6,24 @@ import struct
 import sys
 
 import ljd.bytecode.constants
+import ljd.rawdump.header as _hdr
+
+_XHASH_NAMES = {}
+
+def load_xhash_names(path):
+    import json
+    _XHASH_NAMES.update({int(k, 16): v for k, v in json.load(open(path)).items()})
+
+class XHash(str):
+    '''A T9 hashed-string constant, rendered as #name or #hash_xxx'''
+    pass
+
+def _xhash(parser):
+    hi = parser.stream.read_uleb128()
+    lo = parser.stream.read_uleb128()
+    h = lo | (hi << 32)
+    name = _XHASH_NAMES.get(h)
+    return XHash('#' + name if name else '#hash_%x' % h)
 
 BCDUMP_KGC_CHILD = 0
 BCDUMP_KGC_TAB = 1
@@ -49,6 +67,17 @@ def _read_complex_constants(parser, complex_constants):
     while i < parser.complex_constants_count:
         constant_type = parser.stream.read_uleb128()
 
+        if _hdr.T9:
+            # T9: 0 child, 1 tab, 2 i64, 3 u64, 4 xhash, 5 complex, 6+ str
+            if constant_type == 4:
+                complex_constants.append(_xhash(parser))
+                i += 1
+                continue
+            if constant_type == 5:
+                constant_type = BCDUMP_KGC_COMPLEX
+            elif constant_type >= 6:
+                constant_type = BCDUMP_KGC_STR + (constant_type - 6)
+
         if constant_type >= BCDUMP_KGC_STR:
             length = constant_type - BCDUMP_KGC_STR
 
