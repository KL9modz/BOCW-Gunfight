index 38d7953..7bd7179 100644
--- a/ljd/rawdump/prototype.py
+++ b/ljd/rawdump/prototype.py
@@ -141,6 +141,16 @@ def _read_debuginfo(stream, prototype):
     if stream.debuginfo_size == 0:
         return True
 
+    import ljd.rawdump.header as _hdr
+    if _hdr.T9:
+        # T9 debug block = line info only (no upvalue/variable names); it may be
+        # followed by padding, so seek to its declared end afterwards.
+        start = stream.stream.pos
+        r = ljd.rawdump.debuginfo._read_lineinfo(stream, prototype.first_line_number,
+                                                 prototype.debuginfo.addr_to_line_map)
+        stream.stream.pos = start + stream.debuginfo_size
+        return r
+
     return ljd.rawdump.debuginfo.read(stream,
                                       prototype.first_line_number,
                                       prototype.debuginfo)
