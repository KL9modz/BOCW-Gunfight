new file mode 100644
index 0000000..0734f8f
--- /dev/null
+++ b/ljd/rawdump/luajit/t9/luajit_opcode.py
@@ -0,0 +1,11 @@
+#
+# Cold War (T9) LuaJIT 2.1 variant: one extra opcode KXHASH at 0x28 (load an
+# xhash constant), every stock opcode from KCDATA onward shifted by +1.
+# Measured 2026-09-17 on core_ui.ff (proto tails = RET*, JMP = 0x59).
+#
+import ljd.bytecode.instructions as instructions
+from ljd.rawdump.luajit.v2_1.luajit_opcode import _OPCODES as _STOCK
+
+KXHASH = instructions._IDef("KXHASH", instructions.T_DST, None, instructions.T_STR, "{A} = {D}")
+
+_OPCODES = tuple((op if op < 0x28 else op + 1, cls) for op, cls in _STOCK) + ((0x28, KXHASH),)
